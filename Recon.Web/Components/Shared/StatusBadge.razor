<span class="inline-flex min-w-32 items-center justify-center whitespace-nowrap rounded-full px-3 py-1 text-center text-xs font-medium @Classes">@Text</span>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = "";

    /// <summary>green | green-soft | gray | red | amber | blue</summary>
    [Parameter] public string Color { get; set; } = "gray";

    private string Classes => Color switch
    {
        "green" => "bg-emerald-200 dark:bg-emerald-800",
        "green-soft" => "bg-emerald-100 dark:bg-emerald-700",
        "red" => "bg-red-200 dark:bg-red-800",
        "amber" => "bg-amber-200 dark:bg-amber-800",
        "blue" => "bg-primary-200 dark:bg-primary-800",
        _ => "bg-gray-200 dark:bg-gray-600"
    };
}
