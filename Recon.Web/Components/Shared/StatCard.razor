<div class="recon-card rounded-xl p-5 text-black shadow-sm transition-shadow hover:shadow-md @CardClasses">
    <div class="flex items-start justify-between">
        <div>
            <p class="text-sm font-medium text-black">@Label</p>
            <p class="mt-1.5 text-3xl font-semibold tracking-tight text-black">@Value</p>
            @if (!string.IsNullOrEmpty(Hint))
            {
                <p class="recon-card-muted mt-1 text-xs">@Hint</p>
            }
        </div>
        <div class="rounded-lg p-2.5 @AccentClasses">
            @Icon
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public string? Hint { get; set; }
    [Parameter] public RenderFragment? Icon { get; set; }

    /// <summary>blue | green | amber | violet | red</summary>
    [Parameter] public string Accent { get; set; } = "blue";

    private string CardClasses => Accent switch
    {
        "green" => "recon-card--processed",
        "amber" => "recon-card--warning",
        "violet" => "recon-card--info",
        "red" => "recon-card--exception",
        _ => "recon-card--info"
    };

    private string AccentClasses => "recon-card-icon";
}
