<div class="recon-card rounded-2xl p-5 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg @CardClasses">
    <div class="flex items-start gap-3">
        <div class="rounded-xl p-2.5 @AccentClasses">
            @Icon
        </div>
        <div class="min-w-0">
            <p class="text-sm font-medium text-slate-600 dark:text-slate-300">@Label</p>
            <p class="mt-1 text-3xl font-semibold tracking-tight @ValueClasses">@Value</p>
            @if (!string.IsNullOrEmpty(Hint))
            {
                <p class="recon-card-muted mt-1 text-xs">@Hint</p>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public string? Hint { get; set; }
    [Parameter] public RenderFragment? Icon { get; set; }

    /// <summary>blue | green | amber | violet | red</summary>
    [Parameter] public string Accent { get; set; } = "blue";

    private string CardClasses => Accent switch
    {
        "green" => "recon-card--processed",
        "amber" => "recon-card--warning",
        "violet" => "recon-card--info",
        "red" => "recon-card--exception",
        _ => "recon-card--info"
    };

    private string AccentClasses => $"recon-card-icon recon-card-icon--{Accent}";
    private string ValueClasses => Accent switch
    {
        "red" => "text-rose-600 dark:text-rose-300",
        "amber" => "text-amber-600 dark:text-amber-300",
        "green" => "text-emerald-700 dark:text-emerald-300",
        _ => "text-slate-950 dark:text-white"
    };
}
