<div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition-shadow hover:shadow-md dark:border-gray-700 dark:bg-gray-800">
    <div class="flex items-start justify-between">
        <div>
            <p class="text-sm font-medium text-gray-500 dark:text-gray-400">@Label</p>
            <p class="mt-1.5 text-3xl font-semibold tracking-tight text-gray-900 dark:text-white">@Value</p>
            @if (!string.IsNullOrEmpty(Hint))
            {
                <p class="mt-1 text-xs text-gray-400 dark:text-gray-500">@Hint</p>
            }
        </div>
        <div class="rounded-lg p-2.5 @AccentClasses">
            @Icon
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public string? Hint { get; set; }
    [Parameter] public RenderFragment? Icon { get; set; }

    /// <summary>blue | green | amber | violet | red</summary>
    [Parameter] public string Accent { get; set; } = "blue";

    private string AccentClasses => Accent switch
    {
        "green" => "bg-emerald-50 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400",
        "amber" => "bg-amber-50 text-amber-600 dark:bg-amber-900/30 dark:text-amber-400",
        "violet" => "bg-violet-50 text-violet-600 dark:bg-violet-900/30 dark:text-violet-400",
        "red" => "bg-red-50 text-red-600 dark:bg-red-900/30 dark:text-red-400",
        _ => "bg-primary-50 text-primary-600 dark:bg-primary-900/30 dark:text-primary-400"
    };
}
