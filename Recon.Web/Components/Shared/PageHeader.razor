<section class="mb-6 overflow-hidden rounded-2xl bg-primary-700 px-5 py-5 text-white shadow-sm sm:px-7 sm:py-6">
    <nav class="mb-5 flex items-center gap-1.5 text-xs text-primary-200">
        <a href="/" class="hover:text-white">Home</a>
        @foreach (var crumb in Breadcrumbs)
        {
            <ChevronRightIcon @key="crumb" Class="h-3 w-3" />
            <span>@crumb</span>
        }
    </nav>
    <div class="flex flex-wrap items-center justify-between gap-5">
        <div class="flex items-center gap-4">
            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-white/15 shadow-sm">
                @HeaderIcon()
            </div>
            <div>
                @if (!string.IsNullOrWhiteSpace(Eyebrow))
                {
                    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary-200">@Eyebrow</p>
                }
                <h1 class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl">@Title</h1>
                @if (!string.IsNullOrEmpty(Subtitle))
                {
                    <p class="mt-1 text-sm text-primary-100">@Subtitle</p>
                }
            </div>
        </div>
        @if (Actions is not null)
        {
            <div class="flex items-center gap-2">@Actions</div>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string Icon { get; set; } = "chart";
    [Parameter] public string[] Breadcrumbs { get; set; } = [];
    [Parameter] public RenderFragment? Actions { get; set; }

    private RenderFragment HeaderIcon() => Icon switch
    {
        "dashboard" => @<GridIcon Class="h-7 w-7" />,
        "atm" => @<RocketIcon Class="h-7 w-7" />,
        "pos" => @<TableRowIcon Class="h-7 w-7" />,
        "bulk" => @<ChartIcon Class="h-7 w-7" />,
        "exceptions" => @<ExclamationTriangleIcon Class="h-7 w-7" />,
        "import" => @<FileImportIcon Class="h-7 w-7" />,
        "batches" => @<ListIcon Class="h-7 w-7" />,
        "users" => @<UsersIcon Class="h-7 w-7" />,
        "roles" => @<LockIcon Class="h-7 w-7" />,
        "workflow" => @<CheckCircleIcon Class="h-7 w-7" />,
        _ => @<ChartIcon Class="h-7 w-7" />
    };
}
