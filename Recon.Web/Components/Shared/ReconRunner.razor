@inject IDbContextFactory<Recon.Web.Data.AppDbContext> DbFactory
@inject Recon.Web.Services.Import.IImportService ImportService
@inject Recon.Web.Services.Recon.IReconEngine Engine
@inject Recon.Web.Services.Recon.IBatchArchiveService BatchArchive
@inject NavigationManager Nav
@using Microsoft.EntityFrameworkCore
@using Recon.Web.Domain.Import
@using Recon.Web.Services.Import
@using Recon.Web.Services.Recon

<PageHeader Title="@Title" Subtitle="@Subtitle" Eyebrow="Reconciliation" Icon="@HeaderIcon" Breadcrumbs="@(new[] { "Reconciliation", BreadcrumbGroup ?? ShortName })" />

<NavigationLock OnBeforeInternalNavigation="PreventNavigationWhileRunning" ConfirmExternalNavigation="@_running" />

<div class="grid gap-6 lg:grid-cols-5">
    <!-- Create batch -->
    <div class="lg:col-span-2">
        <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-700 dark:bg-gray-800">
            <h2 class="mb-4 text-sm font-semibold text-gray-900 dark:text-white">New reconciliation batch</h2>

            <div class="mb-4 grid grid-cols-2 gap-3">
                <div>
                    <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Period from</label>
                    <input type="date" @bind="_from" class="w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2 text-sm text-gray-900 focus:border-primary-500 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white" />
                </div>
                <div>
                    <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Period to</label>
                    <input type="date" @bind="_to" class="w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2 text-sm text-gray-900 focus:border-primary-500 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white" />
                </div>
            </div>

            <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">CMS transaction file</label>
            <div class="mb-4 flex min-w-0 items-center gap-3">
                <InputFile id="trx-upload" OnChange="OnTrxSelected" accept=".xlsx,.csv" disabled="@_running" class="sr-only" />
                <label for="trx-upload" class="inline-flex shrink-0 cursor-pointer items-center rounded-lg bg-primary-600 px-3.5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-primary-700 @(_running ? "pointer-events-none opacity-50" : "")">
                    Choose file
                </label>
                <span class="min-w-0 truncate text-sm @(_trxFile is null ? "text-gray-400" : "text-emerald-600 dark:text-emerald-400")">@(_trxFile?.Name ?? "No file selected")</span>
            </div>

            <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Bank ledger file</label>
            <div class="mb-4 flex min-w-0 items-center gap-3">
                <InputFile id="gl-upload" OnChange="OnGlSelected" accept=".xlsx,.csv" disabled="@_running" class="sr-only" />
                <label for="gl-upload" class="inline-flex shrink-0 cursor-pointer items-center rounded-lg bg-primary-600 px-3.5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-primary-700 @(_running ? "pointer-events-none opacity-50" : "")">
                    Choose file
                </label>
                <span class="min-w-0 truncate text-sm @(_glFile is null ? "text-gray-400" : "text-emerald-600 dark:text-emerald-400")">@(_glFile?.Name ?? "No file selected")</span>
            </div>

            <fieldset class="mb-4 rounded-lg border border-gray-200 bg-gray-50 p-3 dark:border-gray-700 dark:bg-gray-700/30">
                <legend class="px-1 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Run parameters</legend>
                <label class="flex items-start gap-2.5 text-sm text-gray-700 dark:text-gray-200">
                    <input type="checkbox" @bind="_applyAmountTolerance" disabled="@(_running || _configuredAmountTolerance <= 0)" class="mt-0.5 rounded border-gray-300 text-primary-600" />
                    <span><span class="font-semibold">Apply amount tolerance for this new run</span><br /><span class="text-xs text-gray-500 dark:text-gray-400">Accept matching amounts within @(_configuredAmountTolerance.ToString("N2")) and record “Tolerance applied”. Existing completed batches are unchanged.</span></span>
                </label>
            </fieldset>

            @if (_warning is not null)
            {
                <div class="mb-3 flex items-start gap-2 rounded-lg border border-amber-200 bg-amber-50 p-3 text-xs text-amber-800 dark:border-amber-900 dark:bg-amber-900/30 dark:text-amber-300">
                    <ExclamationTriangleIcon Class="mt-0.5 h-4 w-4 shrink-0" />
                    <span>@_warning</span>
                </div>
            }
            @if (_error is not null)
            {
                <div class="mb-3 flex items-start gap-2 rounded-lg border border-red-200 bg-red-50 p-3 text-xs text-red-700 dark:border-red-900 dark:bg-red-900/30 dark:text-red-300">
                    <ExclamationTriangleIcon Class="mt-0.5 h-4 w-4 shrink-0" />
                    <span>@_error</span>
                </div>
            }
            <button type="button" disabled="@(_running || _trxFile is null || _glFile is null)"
                    class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-primary-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary-700 disabled:cursor-not-allowed disabled:opacity-50"
                    @onclick="Run">
                <PlayIcon Class="h-4 w-4" /> <span>@(_confirmNeeded ? "Run anyway" : "Run reconciliation")</span>
            </button>
        </div>
    </div>

    <!-- Existing batches -->
    <div class="lg:col-span-3">
        <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">
            <div class="border-b border-gray-200 px-5 py-3 dark:border-gray-700">
                <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Reconciliation batches</h2>
            </div>
            <table class="w-full text-left text-sm">
                <thead class="text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">
                    <tr class="border-b border-gray-100 dark:border-gray-700">
                        <th class="px-5 py-2.5 font-semibold">Batch</th>
                        <th class="px-5 py-2.5 font-semibold">Period</th>
                        <th class="px-5 py-2.5 text-right font-semibold">Matched</th>
                        <th class="px-5 py-2.5 text-right font-semibold">Exceptions</th>
                        <th class="px-5 py-2.5 text-right font-semibold">Confidence</th>
                        <th class="px-5 py-2.5 font-semibold">Next action</th>
                        <th class="px-5 py-2.5 font-semibold">Responsible</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                    @if (_runs.Count == 0)
                    {
                        <tr><td colspan="7" class="px-5 py-10 text-center text-gray-500 dark:text-gray-400">No batches yet — create one on the left.</td></tr>
                    }
                    @foreach (var r in _runs)
                    {
                        <tr @key="r.ReconRunId" class="cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700/40" @onclick="() => Open(r.ReconRunId)">
                            <td class="px-5 py-3 font-semibold text-primary-700 dark:text-primary-300">#@r.ReconRunId</td>
                            <td class="px-5 py-3 text-gray-700 dark:text-gray-200">@PeriodLabel(r)</td>
                            <td class="px-5 py-3 text-right tabular-nums text-emerald-700 dark:text-emerald-300">@r.MatchedCount.ToString("N0")</td>
                            <td class="px-5 py-3 text-right tabular-nums text-red-700 dark:text-red-300">@r.ExceptionCount.ToString("N0")</td>
                        <td class="px-5 py-3 text-right tabular-nums text-gray-700 dark:text-gray-200">@r.AverageConfidence.ToString("0.0")%</td>
                        <td class="px-5 py-3 text-xs text-gray-700 dark:text-gray-200">@(r.NextAction ?? "Not submitted")</td>
                        <td class="px-5 py-3 text-xs text-gray-500 dark:text-gray-400">@(r.ResponsibleActor ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (_running && _progress is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-gray-950/60 p-4 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="recon-progress-title">
        <div class="w-full max-w-2xl rounded-2xl border border-primary-200 bg-white p-6 shadow-2xl dark:border-primary-800 dark:bg-gray-900 sm:p-7" role="status" aria-live="polite">
            <div class="flex items-start gap-4">
                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-primary-600 text-white shadow-sm"><RefreshIcon Class="h-7 w-7 animate-spin" /></div>
                <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center justify-between gap-2"><h2 id="recon-progress-title" class="text-lg font-bold text-gray-900 dark:text-white">Processing reconciliation</h2><span class="rounded-full bg-primary-100 px-2.5 py-1 text-xs font-semibold text-primary-700 dark:bg-primary-900/40 dark:text-primary-200">Step @_progressStep of 3</span></div>
                    <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">@_progress</p>
                </div>
            </div>

            @if (_progressStep == 3 && _reconTotal > 0)
            {
                <div class="mt-5 rounded-xl bg-primary-50 px-4 py-3 text-center dark:bg-primary-950/30"><p class="text-2xl font-bold tabular-nums text-primary-800 dark:text-primary-200">@_reconProcessed.ToString("N0") <span class="text-base font-medium">of</span> @_reconTotal.ToString("N0")</p><p class="mt-0.5 text-xs font-semibold uppercase tracking-wide text-primary-700 dark:text-primary-300">records processed · @_reconMatched.ToString("N0") matched</p></div>
            }

            <div class="mt-5 h-3 overflow-hidden rounded-full bg-primary-100 dark:bg-primary-950"><div class="h-full rounded-full bg-primary-600 transition-all duration-500" style="width: @ProgressPercent"></div></div>
            <div class="mt-4 grid grid-cols-3 gap-2 text-center text-xs font-semibold">
                <div class="@ProgressStepClass(1)"><span class="mx-auto mb-1 flex h-6 w-6 items-center justify-center rounded-full border text-xs">@(_progressStep > 1 ? "✓" : "1")</span>Processor file</div>
                <div class="@ProgressStepClass(2)"><span class="mx-auto mb-1 flex h-6 w-6 items-center justify-center rounded-full border text-xs">@(_progressStep > 2 ? "✓" : "2")</span>GL file</div>
                <div class="@ProgressStepClass(3)"><span class="mx-auto mb-1 flex h-6 w-6 items-center justify-center rounded-full border text-xs">3</span>Match records</div>
            </div>

            @if (_awaitingDuplicateConfirmation)
            {
                <div class="mt-5 rounded-xl border border-primary-200 bg-primary-50 p-4 dark:border-primary-800 dark:bg-primary-950/30">
                    <p class="text-sm font-bold text-primary-950 dark:text-primary-100">Unique-reference pass complete</p>
                    <p class="mt-1 text-sm text-primary-800 dark:text-primary-200">@_reconMatched.ToString("N0") clean one-to-one records have been matched. Continue to check duplicate, ambiguous, and reference-less records.</p>
                    <button type="button" class="mt-4 inline-flex items-center rounded-lg bg-primary-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-primary-700" @onclick="ContinueWithAmbiguousRecords">Continue with duplicates &amp; ambiguous records</button>
                </div>
            }
            @if (_navigationBlocked)
            {
                <p class="mt-4 rounded-lg bg-amber-50 px-3 py-2 text-center text-xs font-semibold text-amber-800 dark:bg-amber-950/30 dark:text-amber-200">Navigation is unavailable until this reconciliation has completed.</p>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public ReconFunction Function { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter, EditorRequired] public string ShortName { get; set; } = "";
    [Parameter, EditorRequired] public string ProcessorLabel { get; set; } = "";
    [Parameter, EditorRequired] public SourceType ProcessorSource { get; set; }
    /// <summary>Optional breadcrumb group label (e.g. the scheme name) shown instead of the function short name.</summary>
    [Parameter] public string? BreadcrumbGroup { get; set; }
    /// <summary>Scheme profile that owns this screen's batches/runs; null = legacy unscoped screens.</summary>
    [Parameter] public int? SchemeProfileId { get; set; }

    private string HeaderIcon => Function switch
    {
        ReconFunction.AtmToGl => "atm",
        ReconFunction.PosToGl => "pos",
        _ => "bulk"
    };

    private DateTime _from = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime _to = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1).AddDays(-1);
    private IBrowserFile? _trxFile, _glFile;
    private bool _running, _confirmNeeded, _navigationBlocked, _allowCompletionNavigation;
    private string? _error, _warning, _progress;
    private int _progressStep;
    private int _reconProcessed, _reconTotal, _reconMatched;
    private bool _awaitingDuplicateConfirmation;
    private bool _applyAmountTolerance;
    private decimal _configuredAmountTolerance;
    private TaskCompletionSource<bool>? _duplicateConfirmation;
    private List<ReconRun> _runs = new();

    private const long MaxBytes = 200L * 1024 * 1024;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        // Date-range children of a daily/period month container are shown on the Daily recon screen,
        // not here; a rolled-up month batch (ParentPeriodRunId == null) still appears as a normal batch.
        var query = db.ReconRuns.Where(r => r.AnalysisOfRunId == null && r.Function == Function && r.Status == ReconRunStatus.Completed && !r.IsArchived && r.ParentPeriodRunId == null);
        // Scheme-scoped screens show only their own runs; legacy screens show unscoped runs.
        query = SchemeProfileId is { } sp
            ? query.Where(r => r.SchemeProfileId == sp)
            : query.Where(r => r.SchemeProfileId == null);
        _runs = await query.OrderByDescending(r => r.CreatedDate).Take(20).ToListAsync();
        _configuredAmountTolerance = await db.ReconParameters.Select(p => p.AmountTolerance).FirstOrDefaultAsync();
    }

    private void OnTrxSelected(InputFileChangeEventArgs e) { _trxFile = e.File; _confirmNeeded = false; _warning = null; _error = null; }
    private void OnGlSelected(InputFileChangeEventArgs e) { _glFile = e.File; _confirmNeeded = false; _warning = null; _error = null; }

    private async Task Run()
    {
        _error = null;
        if (_trxFile is null || _glFile is null) return;
        var from = DateOnly.FromDateTime(_from);
        var to = DateOnly.FromDateTime(_to);
        var periodAdjusted = false;
        if (to < from) { _error = "Period 'to' must be on or after 'from'."; return; }
        if (await BatchArchive.IsFrozenAsync(Function, from, to, SchemeProfileId))
        { _error = "This reconciliation period is frozen. Select an open period before uploading files."; return; }

        _running = true;
        try
        {
            _progressStep = 1;
            _progress = $"Importing {ProcessorLabel} file…";
            StateHasChanged();
            var trx = await ImportFile(_trxFile);
            if (!trx.Success) { _error = trx.Error; return; }
            if (trx.DetectedType != ProcessorSource)
            {
                _error = $"That file was detected as {trx.DetectedType}, but this screen expects a {ProcessorSource} (TRX) file.";
                return;
            }

            _progressStep = 2;
            _progress = "Importing GL dump…";
            StateHasChanged();
            var gl = await ImportFile(_glFile);
            if (!gl.Success) { _error = gl.Error; return; }
            if (gl.DetectedType != SourceType.GlDump)
            {
                _error = $"The GL slot received a {gl.DetectedType} file — please upload the GL dump.";
                return;
            }

            if (SourcePeriodSelection.Correction(trx.SourcePeriod, gl.SourcePeriod, from, to) is { } correction)
            {
                _warning = $"Period adjusted from {from:dd MMM yyyy} – {to:dd MMM yyyy} to {correction.From:dd MMM yyyy} – {correction.To:dd MMM yyyy}, using the dates inside both files.";
                from = correction.From; to = correction.To;
                _from = from.ToDateTime(TimeOnly.MinValue); _to = to.ToDateTime(TimeOnly.MinValue);
                _confirmNeeded = false;
                periodAdjusted = true;
                StateHasChanged();
            }
            // Check workflow guards against the detected period, rather than an erroneous
            // initial selection. Importing files never authorizes changing frozen results.
            if (await BatchArchive.IsFrozenAsync(Function, from, to, SchemeProfileId))
            { _error = $"The source period {from:dd MMM} – {to:dd MMM yyyy} is frozen. Reconciliation cannot change its results."; return; }
            if (!_confirmNeeded)
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                var dup = await db.ReconRuns.FirstOrDefaultAsync(r => r.Function == Function && r.SchemeProfileId == SchemeProfileId &&
                    r.PeriodStart == from && r.PeriodEnd == to && r.Status == ReconRunStatus.Completed);
                if (dup is not null)
                {
                    _warning = (_warning is null ? "" : _warning + " ") + $"A {ShortName} reconciliation for {from:dd MMM} – {to:dd MMM yyyy} already exists (batch #{dup.ReconRunId}). Running again will create a new batch.";
                    _confirmNeeded = true; return;
                }
            }

            _progressStep = 3;
            _progress = "Matching records and calculating confidence…";
            _reconProcessed = _reconTotal = _reconMatched = 0;
            StateHasChanged();
            var periodKey = from.ToString("yyyy-MM");
            var liveProgress = new Progress<ReconProgress>(p =>
            {
                _progress = p.Stage;
                _reconProcessed = p.Processed;
                _reconTotal = p.Total;
                _reconMatched = p.Matched;
                _ = InvokeAsync(StateHasChanged);
            });
            var result = await Engine.RunAsync(Function, trx.ImportBatchId!.Value, gl.ImportBatchId!.Value, periodKey, from, to, default, liveProgress, PauseBeforeAmbiguousPassAsync, SchemeProfileId, _applyAmountTolerance, _configuredAmountTolerance);
            _allowCompletionNavigation = true;
            Nav.NavigateTo($"/recon/run/{result.ReconRunId}" + (periodAdjusted ? "?sourcePeriodAdjusted=true" : ""));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _running = false;
            _progress = null;
            _progressStep = 0;
            _reconProcessed = _reconTotal = _reconMatched = 0;
            _awaitingDuplicateConfirmation = false;
            _duplicateConfirmation = null;
            _navigationBlocked = false;
            _allowCompletionNavigation = false;
        }
    }

    private Task PreventNavigationWhileRunning(LocationChangingContext context)
    {
        if (!_running || _allowCompletionNavigation) return Task.CompletedTask;

        context.PreventNavigation();
        _navigationBlocked = true;
        return InvokeAsync(StateHasChanged);
    }

    private async Task<ImportOutcome> ImportFile(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(MaxBytes);
        return await ImportService.ImportAsync(stream, file.Name, _from.ToString("yyyy-MM"), SchemeProfileId);
    }

    private async Task PauseBeforeAmbiguousPassAsync(ReconProgress progress)
    {
        _progress = progress.Stage;
        _reconProcessed = progress.Processed;
        _reconTotal = progress.Total;
        _reconMatched = progress.Matched;
        _awaitingDuplicateConfirmation = true;
        _duplicateConfirmation = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
        await InvokeAsync(StateHasChanged);
        await _duplicateConfirmation.Task;
    }

    private Task ContinueWithAmbiguousRecords()
    {
        _awaitingDuplicateConfirmation = false;
        _progress = "Evaluating duplicate and ambiguous records…";
        _duplicateConfirmation?.TrySetResult(true);
        return InvokeAsync(StateHasChanged);
    }

    private void Open(int runId) => Nav.NavigateTo($"/recon/run/{runId}");

    private string ProgressPercent => _progressStep switch
    {
        1 => "20%",
        2 => "55%",
        3 when _reconTotal > 0 => $"{Math.Min(98, 60 + 38 * _reconProcessed / _reconTotal)}%",
        3 => "60%",
        _ => "0%"
    };
    private string ProgressStepClass(int step) => _progressStep >= step
        ? "text-primary-800 dark:text-primary-200" : "text-gray-400 dark:text-gray-500";

    private static string PeriodLabel(ReconRun r) =>
        r.PeriodStart is { } s && r.PeriodEnd is { } e ? $"{s:dd MMM} – {e:dd MMM yyyy}" : r.PeriodKey;
}
