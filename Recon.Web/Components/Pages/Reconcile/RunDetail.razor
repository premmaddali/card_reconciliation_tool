            "matched" => query.Where(m => m.MatchStatus == MatchStatus.Matched),
            "matched_tolerance" => query.Where(m => m.MatchStatus == MatchStatus.Matched && m.MatchComment != null && m.MatchComment.StartsWith("Tolerance applied:")),
