    private static string FunctionName(ReconFunction f) => f switch
    {
        ReconFunction.AtmToGl => "ATM recon",
        ReconFunction.PosToGl => "POS recon",
        ReconFunction.NetworkToAtm => "Network ↔ ATM recon",
        _ => "Bulk recon"
    };

    private static string PeriodLabel(ReconRun r) =>
        r.PeriodStart is { } s && r.PeriodEnd is { } e ? $"{s:dd MMM} – {e:dd MMM yyyy}" : $"Period {r.PeriodKey}";

    private static string CcyName(int? iso) => iso == 0 ? "Other currencies" : IsoCurrencyCatalog.Display(iso);
    private static string SummaryCcyName(int iso) => iso == 0 ? "Other currencies (non-MUR/USD/EUR)" : CcyName(iso);
    private static string LegName(ReconSettlementLeg leg) => leg == ReconSettlementLeg.CreditIntermediary ? "Credit intermediary" : "Debit cardholder";

    private static string AmountCcy(decimal? amount, int? ccy) => amount.HasValue
        ? $"{amount.Value:N2} {CcyName(ccy)}"
        : "—";

    private static string DuplicateList(IEnumerable<DuplicateReference> rows)
    {
        var values = rows.Select(x => $"{x.Reference} ({x.Count} rows)").ToList();
        return values.Count == 0 ? "None" : string.Join(", ", values);
    }

    private static string MatchDecision(ReconMatch match)
    {
        var compared = CcyName(match.Ccy);
        if (match.IsManuallyMatched)
            return $"Manually matched by a reviewer. Reason: {match.MatchComment ?? "No reason recorded"}. The remaining difference is {Difference(match)?.ToString("N2") ?? "—"} {compared}.";
        if (match.MatchStatus == MatchStatus.Matched)
            return $"Matched: the compared billing amount ({match.ReconciliationAmount:N2} {compared}) agrees with the GL amount ({match.GlAmount:N2} {CcyName(match.GlCcy ?? 480)}). The reference and transaction channel also agree.";
        if (match.MatchStatus == MatchStatus.AmountMismatch)
            return $"Not matched on amount: the reference and transaction channel identify the same transaction, but the compared processor amount ({match.ReconciliationAmount:N2} {compared}) differs from the GL amount ({match.GlAmount:N2} {CcyName(match.GlCcy ?? 480)}). The confidence reflects the reference/channel evidence only; it is not an amount-match percentage.";
        if (match.MatchStatus == MatchStatus.UnmatchedProcessor)
            return "No suitable GL entry was found for this processor transaction.";
        return "This transaction needs review because more than one possible match was found.";
    }

    private static string MaskCard(string? cardNumber)
    {
        if (string.IsNullOrWhiteSpace(cardNumber)) return "";
        var value = cardNumber.Trim();
        return value.Length <= 4 ? "****" : $"****{value[^4..]}";
    }

    private static string Humanize(MatchStatus s) => s switch
    {
        MatchStatus.UnmatchedProcessor => "No GL match",
        MatchStatus.UnmatchedGl => "GL unmatched",
        MatchStatus.AmountMismatch => "Amount mismatch",
        MatchStatus.Ambiguous => "Ambiguous",
        _ => s.ToString()
    };

    private static bool IsToleranceMatch(ReconMatch match) => match.MatchStatus == MatchStatus.Matched
        && match.MatchComment?.StartsWith("Tolerance applied:", StringComparison.Ordinal) == true;
    private static string ConfidenceLabel(ReconMatch match) =>
        !match.IsManuallyMatched && match.MatchStatus == MatchStatus.Matched && match.ScoreBreakdown?.StartsWith(Recon.Web.Services.Recon.SecondaryMatchService.MethodLabel) == true
            ? $"Medium ({match.Confidence:0.0}%)" : $"{match.Confidence:0.0}%";

    private static string ResultLabel(ReconMatch match) => match.MatchStatus == MatchStatus.Matched && !match.IsManuallyMatched && match.ScoreBreakdown?.StartsWith(Recon.Web.Services.Recon.SecondaryMatchService.CardMethodLabel) == true ? "Matched with Card Number" : match.MatchStatus == MatchStatus.Matched && match.ScoreBreakdown?.StartsWith(Recon.Web.Services.Recon.SecondaryMatchService.MethodLabel) == true ? "Matched Date/Amount/Cur" : IsToleranceMatch(match) ? "Matched with tolerance" : Humanize(match.MatchStatus);
    private static string ResultColor(ReconMatch match) => IsToleranceMatch(match) ? "green-soft" : match.MatchStatus == MatchStatus.Matched ? "green" : TypeColor(match.MatchStatus);

    private static string TypeColor(MatchStatus s) => s switch
    {
        MatchStatus.AmountMismatch => "amber",
        MatchStatus.UnmatchedProcessor => "red",
        MatchStatus.UnmatchedGl => "gray",
        _ => "blue"
    };

    private static string StatusColor(ExceptionStatus s) => s switch
    {
        ExceptionStatus.Resolved => "green",
        ExceptionStatus.WrittenOff => "blue",
        ExceptionStatus.Investigating => "amber",
        _ => "gray"
    };

