    private static string PassName(ReconPassKind k) => k switch
    {
        ReconPassKind.InitialAnalysis => "Initial matching",
        ReconPassKind.SecondaryAmount => "Date/Amount/Cur",
        ReconPassKind.CardNumber => "Card number",
        _ => "Previous/Next period"
    };

    private Task RunSecondaryMatching() => RunMatching(false);
    private Task RunAdjacentMatching() => RunMatching(true);
    private Task RunCardMatching() => RunMatching(false, card: true);

    private async Task RerunAnalysis()
    {
        if (_secondaryBusy) return;
        _secondaryBusy = true; _secondaryError = null; _secondaryResult = null;
        _secondaryProgress = "Preparing stored source data…";
        await InvokeAsync(StateHasChanged);
        try
        {
            var progress = new Progress<Recon.Web.Services.Recon.ReconProgress>(p =>
            {
                _secondaryProgress = p.Total > 0 ? $"{p.Stage} {p.Processed:N0} / {p.Total:N0} records · {p.Matched:N0} matched" : p.Stage;
                _ = InvokeAsync(StateHasChanged);
            });
            var result = await Analysis.RunAsync(RunId, progress);
            _tab = Tab.Reconciliation;
            _matchPage = 0;
            Nav.NavigateTo($"/recon/run/{result.RunId}");
        }
        catch (Exception ex)
        {
            SecondaryLogger.LogError(ex, "Re-analysis failed for batch {RunId}", RunId);
            _secondaryError = ex is InvalidOperationException or UnauthorizedAccessException ? ex.Message
                : "Analysis failed. The original batch is unchanged. Check the logs before retrying.";
            await OnParametersSetAsync();
        }
        finally { _secondaryBusy = false; _secondaryProgress = null; }
    }

    private async Task RunMatching(bool adjacent, bool card = false)
    {
        if (_secondaryBusy) return;
        _secondaryBusy = true; _secondaryError = null; _secondaryResult = null;
        _secondaryProgress = card ? "Matching on card number…" : adjacent ? "Reconciling previous/next period…" : "Matching on date, amount and currency…";
        await InvokeAsync(StateHasChanged);
        try
        {
            var result = card ? await SecondaryMatching.RunCardAsync(RunId)
                : adjacent ? await SecondaryMatching.RunAdjacentAsync(RunId) : await SecondaryMatching.RunAsync(RunId);
            var label = card ? "Card-number matching" : adjacent ? "Previous/next period matching" : "Date/Amount/Cur matching";
            _secondaryResult = $"{label}: {result.Added} additional match{(result.Added == 1 ? "" : "es")}" +
                (result.Ambiguous > 0 ? $"; {result.Ambiguous} need review." : ".");
            await OnParametersSetAsync(); // reload this same batch in place — no new batch is created
        }
        catch (UnauthorizedAccessException ex) { _secondaryError = ex.Message; }
        catch (InvalidOperationException ex) { _secondaryError = ex.Message; }
        catch (Exception ex) { SecondaryLogger.LogError(ex, "Secondary matching failed for run {RunId}", RunId); _secondaryError = "Secondary matching failed. No partial run was saved. Check the server logs and retry."; }
        finally { _secondaryBusy = false; _secondaryProgress = null; }
    }
    private bool _canArchive, _canFreeze, _canManualGlMatch;
