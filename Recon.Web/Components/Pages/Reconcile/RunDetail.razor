    private async Task SaveManualMatches()
    {
        if (_run?.AnalysisOfRunId is not null) { _manualMatchError = "Analysis results are read-only."; return; }
        if (string.IsNullOrWhiteSpace(_manualMatchComment)) { _manualMatchError = "Enter a reason before marking records as matched."; return; }
        await using var db = await DbFactory.CreateDbContextAsync();
        var matches = await db.ReconMatches.Where(m => m.ReconRunId == RunId && _selectedMatchIds.Contains(m.ReconMatchId) && m.MatchStatus != MatchStatus.Matched && m.GlStagingId != null).ToListAsync();
        if (matches.Count == 0) { _manualMatchError = "No eligible rows are selected."; return; }
        var references = matches.Where(m => !string.IsNullOrWhiteSpace(m.ReferenceNumber)).Select(m => m.ReferenceNumber!).Distinct().ToList();
        var legs = matches.Select(m => m.SettlementLeg).Distinct().ToList();
        foreach (var match in matches)
        {
            match.MatchStatus = MatchStatus.Matched;
            match.IsManuallyMatched = true;
            match.ManuallyMatchedDate = DateTime.UtcNow;
            match.MatchComment = _manualMatchComment.Trim();
            match.ScoreBreakdown = "Manually matched: " + match.MatchComment;
            match.Confidence = Math.Max(match.Confidence, 100m);
        }
        var linkedExceptions = await db.ReconExceptions.Where(e => e.ReconRunId == RunId && e.ExceptionType == MatchStatus.AmountMismatch && e.Status != ExceptionStatus.Resolved && references.Contains(e.ReferenceNumber!) && e.SettlementLeg != null && legs.Contains(e.SettlementLeg.Value)).ToListAsync();
        foreach (var exception in linkedExceptions) { exception.Status = ExceptionStatus.Resolved; exception.ResolvedDate = DateTime.UtcNow; exception.ResolvedBy = CurrentUser.UserId; }
        await db.SaveChangesAsync();
        await RebuildSummariesAsync(db);
        var run = await db.ReconRuns.FindAsync(RunId);
        if (run is not null)
        {
            run.MatchedCount = await db.ReconMatches.CountAsync(m => m.ReconRunId == RunId && m.MatchStatus == MatchStatus.Matched);
            run.ExceptionCount = await db.ReconExceptions.CountAsync(e => e.ReconRunId == RunId && e.Status != ExceptionStatus.Resolved);
            await db.SaveChangesAsync();
        }
        _selectedMatchIds.Clear();
        _showMatchDrawer = false;
        _run = run;
        await ReloadMatches();
    }

    private async Task RebuildSummariesAsync(Recon.Web.Data.AppDbContext db)
    {
        var rows = await db.ReconMatches.Where(m => m.ReconRunId == RunId)
            .Select(m => new { m.SettlementLeg, m.Ccy, m.ProcessorDate, m.MatchStatus, m.ReconciliationAmount, m.ProcessorAmount, m.Confidence }).ToListAsync();
        db.ReconPassSummaries.RemoveRange(await db.ReconPassSummaries.Where(s => s.ReconRunId == RunId).ToListAsync());
        foreach (var group in rows.Where(r => r.ProcessorDate.HasValue).GroupBy(r => (r.SettlementLeg, Ccy: SummaryCcy(r.Ccy), Day: r.ProcessorDate)).Concat(rows.GroupBy(r => (r.SettlementLeg, Ccy: SummaryCcy(r.Ccy), Day: (DateOnly?)null))))
        {
            var matched = group.Where(r => r.MatchStatus == MatchStatus.Matched).ToList();
            var exceptions = group.Where(r => r.MatchStatus != MatchStatus.Matched).ToList();
            db.ReconPassSummaries.Add(new ReconPassSummary
            {
                ReconRunId = RunId, SettlementLeg = group.Key.SettlementLeg, Ccy = group.Key.Ccy, Day = group.Key.Day,
                MatchedCount = matched.Count, MatchedAmount = matched.Sum(r => r.ReconciliationAmount ?? r.ProcessorAmount ?? 0m),
                ExceptionCount = exceptions.Count, ExceptionAmount = exceptions.Sum(r => r.ReconciliationAmount ?? r.ProcessorAmount ?? 0m),
                AverageConfidence = matched.Count == 0 ? 0m : Math.Round(matched.Average(r => r.Confidence), 2)
            });
        }
        await db.SaveChangesAsync();
    }

    private static int SummaryCcy(int? ccy) => ccy is 480 or 840 or 978 ? ccy.Value : 0;

    private IEnumerable<int> CurrencyOptions() => _matchCurrencies.Union(new[] { 480, 840, 978 }).OrderBy(c => c);
    private string MatchExportUrl()
    {
        var query = new Dictionary<string, string?>
        {
            ["result"] = _matchFilter, ["reference"] = _matchReferenceFilter, ["microfilm"] = _matchMicrofilmFilter, ["glParticular2"] = _matchGlParticular2Filter, ["processorAccount"] = _matchProcessorAccountFilter,
            ["search"] = _matchSearchFilter, ["cardType"] = _matchCardTypeFilter, ["merchant"] = _matchMerchantFilter, ["processorDescription"] = _matchProcessorDescriptionFilter,
            ["glAccount"] = _matchGlAccountFilter, ["txnCcy"] = _matchTxnCcyFilter, ["billingCcy"] = _matchBillingCcyFilter,
            ["settlementCcy"] = _matchSettlementCcyFilter, ["reconCcy"] = _matchReconCcyFilter, ["otherReconCcy"] = _matchOtherReconCcy ? "true" : null, ["leg"] = _matchLegFilter, ["glCcy"] = _matchGlCcyFilter, ["maxDifference"] = _maxDifference,
            ["processorDate"] = _matchProcessorDateFilter?.ToString("yyyy-MM-dd"), ["glDate"] = _matchGlDateFilter?.ToString("yyyy-MM-dd"), ["glPostingDate"] = _matchGlPostingDateFilter?.ToString("yyyy-MM-dd"),
            ["sort"] = _matchSort, ["sortDescending"] = _matchSortDescending ? "true" : "false"
        };
        var parameters = string.Join("&", query.Where(x => !string.IsNullOrWhiteSpace(x.Value))
            .Select(x => $"{Uri.EscapeDataString(x.Key)}={Uri.EscapeDataString(x.Value!)}"));
        return $"/api/recon/{RunId}/matches.csv{(parameters.Length == 0 ? "" : "?" + parameters)}";
    }
