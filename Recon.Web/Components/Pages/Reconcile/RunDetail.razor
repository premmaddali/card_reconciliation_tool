    {
        if (_run is null || _interchangeAudit is null) return;
        _showDuplicateDrawer = true;
        _duplicateTab = "interchange";
        _duplicateDetailsLoading = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var interchangeRefs = _interchangeAudit.InterchangeDuplicates.Select(x => x.Reference).ToList();
            var glRefs = _interchangeAudit.GlDuplicates.Select(x => x.Reference).ToList();
            var interchangeRows = await db.StgInterchangeFees
                .Where(x => x.ImportBatchId == _run.ProcessorBatchId && interchangeRefs.Contains(x.ReferenceNumber!))
                .Select(x => new { x.ReferenceNumber, x.SourceRowNumber, x.ProcessingDate, x.TransactionDate, x.CardAccountNumber, x.TxnAmount, x.TxnCcy, x.BillingAmount, x.BillingCcy, x.SettlementAmount, x.SettlementCcy, x.TransactionWording })
                .ToListAsync();
            _interchangeDuplicateDetails = interchangeRows.Select(x => new InterchangeDuplicateDetail(x.ReferenceNumber!, x.SourceRowNumber, x.ProcessingDate ?? (x.TransactionDate.HasValue ? DateOnly.FromDateTime(x.TransactionDate.Value) : null), x.CardAccountNumber, x.TxnAmount, x.TxnCcy, x.BillingAmount, x.BillingCcy, x.SettlementAmount, x.SettlementCcy, x.TransactionWording)).ToList();
            _glDuplicateDetails = await db.StgGlEntries
                .Where(x => x.ImportBatchId == _run.GlBatchId && glRefs.Contains(x.TranParticular2!))
                .Select(x => new GlDuplicateDetail(x.TranParticular2!, x.SourceRowNumber, x.TranDate, x.AcctNum, x.TranAmt, x.TranCcyCode, x.TranParticular))
                .ToListAsync();
