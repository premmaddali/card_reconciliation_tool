    private IQueryable<StgGlEntry> GlQuery(Recon.Web.Data.AppDbContext db)
    {
        var q = db.StgGlEntries.Where(x => _sourceGlBatchIds.Contains(x.ImportBatchId) && x.AcctNum != null && _cardholderAccts.Contains(x.AcctNum));
        if (_run!.Function != ReconFunction.InterchangeToGl)
            q = q.Where(x => x.AcctNum != null && _debitAccounts.Contains(x.AcctNum));
        if (int.TryParse(DataFilterValue("Source row"), out var sourceRow)) q = q.Where(x => x.SourceRowNumber == sourceRow);
        q = ApplyTextFilter(q, "SOL ID", x => x.SolId);
        q = ApplyTextFilter(q, "Account number", x => x.AcctNum);
        q = ApplyTextFilter(q, "GL sub-head code", x => x.GlSubHeadCode);
        q = ApplyTextFilter(q, "GL account", x => x.GlAccount);
        q = ApplyTextFilter(q, "Account name", x => x.AcctName);
        if (DateOnly.TryParse(DataFilterValue("Transaction date"), out var transactionDate)) q = q.Where(x => x.TranDate == transactionDate);
        q = ApplyTextFilter(q, "Transaction ID", x => x.TranId);
        q = ApplyTextFilter(q, "Reference number", x => x.RefNum);
        q = ApplyTextFilter(q, "Particular", x => x.TranParticular);
        q = ApplyTextFilter(q, "Particular 2", x => x.TranParticular2);
        q = ApplyTextFilter(q, "Particular code", x => x.TranParticularCode);
        q = ApplyTextFilter(q, "TRAN_RMKS (card matching)", x => x.TranRmks);
        q = ApplyTextFilter(q, "Transaction currency", x => x.TranCcyCode);
        q = ApplyTextFilter(q, "Entry user", x => x.EntryUserId);
        q = ApplyTextFilter(q, "Verified user", x => x.VfdUserId);
        // Channel scope by TRAN_PARTICULAR prefix.
        return _run!.Function switch
        {
            ReconFunction.AtmToGl => q.Where(x => x.TranParticular != null && x.TranParticular.StartsWith("CASH")),
            ReconFunction.PosToGl => q.Where(x => x.TranParticular != null && x.TranParticular.StartsWith("POS")),
            _ => q
        };
    }

    private IQueryable<StgGlBulkPosting> GlBulkQuery(Recon.Web.Data.AppDbContext db)
    {
        var q = db.StgGlBulkPostings.Where(x => _sourceGlBatchIds.Contains(x.ImportBatchId) && x.AcctNum != null && _cardholderAccts.Contains(x.AcctNum));
        if (_run!.Function != ReconFunction.InterchangeToGl)
            q = q.Where(x => x.AcctNum != null && _debitAccounts.Contains(x.AcctNum));
        if (int.TryParse(DataFilterValue("Source row"), out var sourceRow)) q = q.Where(x => x.SourceRowNumber == sourceRow);
        q = ApplyTextFilter(q, "Account", x => x.AcctNum);
        var referenceMode = DataFilterMode("Reference");
        if (referenceMode == "blank") q = q.Where(x => (x.TranParticular2 == null || x.TranParticular2 == "") && (x.RefNum == null || x.RefNum == ""));
        else if (referenceMode == "not_blank") q = q.Where(x => (x.TranParticular2 != null && x.TranParticular2 != "") || (x.RefNum != null && x.RefNum != ""));
        else if (!string.IsNullOrWhiteSpace(DataFilterValue("Reference")))
        {
            var reference = DataFilterValue("Reference");
            q = q.Where(x => (x.TranParticular2 != null && x.TranParticular2.Contains(reference))
                || (x.RefNum != null && x.RefNum.Contains(reference)));
        }
        if (DateOnly.TryParse(DataFilterValue("Date"), out var date)) q = q.Where(x => x.TranDate == date);
        q = ApplyTextFilter(q, "Particular", x => x.TranParticular);
        q = ApplyTextFilter(q, "Remarks", x => x.TranRmks);
        return q;
    }

