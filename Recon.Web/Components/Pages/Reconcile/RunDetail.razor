        var settlementRows = details.Where(x => x.IsSettlementPosting).ToList();

        _glOnlyTransactionCount = transactionRows.Count;
        _glOnlySettlementPostingCount = settlementRows.Count;
        _glOnlyTransactionAmount = transactionRows.Sum(x => x.Amount ?? 0m);
        _glOnlySettlementPostingAmount = settlementRows.Sum(x => x.Amount ?? 0m);
        _glOnlyDetails = transactionRows.OrderByDescending(x => x.Amount ?? 0m).Take(GlOnlyDetailCap)
            .Concat(settlementRows.OrderByDescending(x => x.Amount ?? 0m).Take(GlOnlyDetailCap)).ToList();
    }

    private async Task LoadNetworkValidationAsync()
    {
        if (_run?.Function is not (ReconFunction.AtmToGl or ReconFunction.NetworkToAtm))
        {
            _networkValidations = [];
            _networkValidationTotal = _networkMatched = _networkMismatches = _networkOneSided = _networkDuplicates = 0;
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var runResults = db.AtmNetworkValidations.Where(item => item.ReconRunId == RunId);
        _networkMatched = await runResults.CountAsync(item => item.Status == AtmNetworkValidationStatus.Matched);
        _networkMismatches = await runResults.CountAsync(item => item.Status == AtmNetworkValidationStatus.AmountMismatch || item.Status == AtmNetworkValidationStatus.FeeMismatch || item.Status == AtmNetworkValidationStatus.CurrencyMismatch);
        _networkOneSided = await runResults.CountAsync(item => item.Status == AtmNetworkValidationStatus.MissingNetwork || item.Status == AtmNetworkValidationStatus.MissingAtm);
        _networkDuplicates = await runResults.CountAsync(item => item.Status == AtmNetworkValidationStatus.Duplicate);

        var query = runResults;
        if (Enum.TryParse<AtmNetworkValidationStatus>(_networkStatusFilter, out var status)) query = query.Where(item => item.Status == status);
        if (!string.IsNullOrWhiteSpace(_networkReferenceFilter)) query = query.Where(item => item.ReferenceNumber != null && item.ReferenceNumber.Contains(_networkReferenceFilter));
        if (!string.IsNullOrWhiteSpace(_networkSearchFilter))
        {
            query = query.Where(item => (item.ReferenceNumber != null && item.ReferenceNumber.Contains(_networkSearchFilter)) || (item.Narrative != null && item.Narrative.Contains(_networkSearchFilter)));
        }
        if (_networkNetworkDateFilter is { } networkDate) query = query.Where(item => item.NetworkDate == networkDate);
        if (_networkAtmDateFilter is { } atmDate) query = query.Where(item => item.AtmDate == atmDate);
        if (int.TryParse(_networkNetworkCcyFilter, out var networkCcy)) query = query.Where(item => item.NetworkCcy == networkCcy);
        if (int.TryParse(_networkAtmCcyFilter, out var atmCcy)) query = query.Where(item => item.AtmCcy == atmCcy);
        _networkValidationTotal = await query.CountAsync();
        if (_networkValidationPage >= NetworkValidationPageCount) _networkValidationPage = 0;
        _networkValidations = await query.OrderBy(item => item.Status).ThenBy(item => item.ReferenceNumber)
            .Skip(_networkValidationPage * NetworkValidationPageSize).Take(NetworkValidationPageSize).ToListAsync();
    }

