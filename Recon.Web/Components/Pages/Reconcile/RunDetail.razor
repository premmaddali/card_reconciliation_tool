    private static decimal? Difference(ReconMatch match) => match.ReconciliationAmount is { } processor && match.GlAmount is { } gl ? Math.Abs(processor - gl) : null;
    private static bool CanManuallyMatch(ReconMatch match) => match.MatchStatus != MatchStatus.Matched && match.GlStagingId is not null && match.ReconciliationAmount is not null && match.GlAmount is not null;
    private bool AllPageEligibleSelected
