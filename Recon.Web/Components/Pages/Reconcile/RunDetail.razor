    private IQueryable<StgNetworkT464> ApplyNetworkTransactionFilters(IQueryable<StgNetworkT464> q)
    {
        if (int.TryParse(DataFilterValue("Source row"), out var sourceRow)) q = q.Where(x => x.SourceRowNumber == sourceRow);
        q = ApplyTextFilter(q, "Reference", x => x.ReferenceNumber);
        q = ApplyTextFilter(q, "Serial number", x => x.SwitchSerialNumber);
        q = ApplyTextFilter(q, "PAN", x => x.Pan);
        q = ApplyTextFilter(q, "Processing code", x => x.ProcessingCode);
        q = ApplyTextFilter(q, "Trace number", x => x.TraceNumber);
        q = ApplyTextFilter(q, "Merchant type", x => x.MerchantType);
        q = ApplyTextFilter(q, "Terminal ID", x => x.TerminalId);
        if (DateOnly.TryParse(DataFilterValue("Transaction date"), out var transactionDate)) q = q.Where(x => x.TransactionDate == transactionDate);
        if (DataFilterValue("Transaction currency") == "__blank__") q = q.Where(x => x.TxnCcy == null);
        else if (int.TryParse(DataFilterValue("Transaction currency"), out var ccy)) q = q.Where(x => x.TxnCcy == ccy);
        return q;
    }

