    private async Task LoadEvidenceAsync(Recon.Web.Data.AppDbContext db, ReconMatch? match, string? reference, string? glAccountNumber)
    {
        if (_run is null) return;
        _processorEvidence = null;
        _glEvidence = null;
        var processorFile = await db.ImportBatches.Where(b => b.ImportBatchId == _run.ProcessorBatchId).Select(b => b.FileName).FirstOrDefaultAsync() ?? "Processor workbook";
        var glFile = await db.ImportBatches.Where(b => b.ImportBatchId == _run.GlBatchId).Select(b => b.FileName).FirstOrDefaultAsync() ?? "GL workbook";

        if (match?.ProcessorSource == StagingSource.InterchangeFee)
        {
            var p = await db.StgInterchangeFees.FirstOrDefaultAsync(x => x.StgInterchangeFeeId == match.ProcessorStagingId);
            if (p is not null) _processorEvidence = new(processorFile, p.SourceRowNumber, p.ReferenceNumber,
                AmountCcy(p.TxnAmount, p.TxnCcy), AmountCcy(p.BillingAmount, p.BillingCcy), AmountCcy(p.SettlementAmount, p.SettlementCcy), p.TransactionWording);
        }
        else if (match is not null)
        {
            var p = await db.StgDebitSettlements.FirstOrDefaultAsync(x => x.StgDebitSettlementId == match.ProcessorStagingId);
            if (p is not null) _processorEvidence = new(processorFile, p.SourceRowNumber, p.ReferenceNumber,
                AmountCcy(p.TxnAmount, p.TxnCcy), AmountCcy(p.BillingAmount, p.BillingCcy), AmountCcy(p.SettlementAmount, p.SettlementCcy), p.TransactionWording);
        }

        var gl = match?.GlStagingId is int glId
            ? await db.StgGlEntries.FirstOrDefaultAsync(x => x.StgGlEntryId == glId)
            : await db.StgGlEntries.FirstOrDefaultAsync(x => x.ImportBatchId == _run.GlBatchId && x.TranParticular2 == reference && (glAccountNumber == null || x.AcctNum == glAccountNumber));
        if (gl is not null) _glEvidence = new(glFile, gl.SourceRowNumber, gl.TranParticular2, gl.AcctNum,
            gl.TranAmt?.ToString("N2") ?? "—", gl.TranParticular);
    }

