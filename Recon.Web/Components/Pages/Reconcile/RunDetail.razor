@page "/recon/run/{RunId:int}"
@inject IDbContextFactory<Recon.Web.Data.AppDbContext> DbFactory
@inject NavigationManager Nav
@inject Recon.Web.Services.Recon.SecondaryMatchService SecondaryMatching
@inject Recon.Web.Services.Recon.ReconAnalysisService Analysis
@inject ILogger<RunDetail> SecondaryLogger
@inject Recon.Web.Services.Recon.IExceptionWorkflowService Workflow
@inject Recon.Web.Services.Recon.IReconVerificationService Verification
@inject Recon.Web.Services.Recon.IBatchArchiveService ArchiveService
@inject Recon.Web.Services.ICurrentUserService CurrentUser
@inject Recon.Web.Services.IPermissionService Permissions
@using Microsoft.EntityFrameworkCore
@using Recon.Web.Domain.Import
@using Recon.Web.Domain.Recon
@using Recon.Web.Domain.Staging
@using Recon.Web.Domain.Reference

<PageTitle>Batch #@RunId · Recon Tool</PageTitle>

@if (_loadError is not null)
{
    <div role="alert" class="mb-5 flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800 dark:border-red-900 dark:bg-red-950/40 dark:text-red-200">
        <ExclamationTriangleIcon Class="mt-0.5 h-5 w-5 shrink-0" />
        <div>
            <p class="font-semibold">Unable to load batch details completely</p>
            <p class="mt-0.5">@_loadError</p>
        </div>
    </div>
}

@if (_run is null)
{
    <p class="text-sm text-gray-500 dark:text-gray-400">Loading batch…</p>
}
else
{
    <section class="mb-5 overflow-hidden rounded-2xl bg-primary-700 px-5 py-6 text-white shadow-sm sm:px-7">
        <div class="mb-5 flex items-center gap-1.5 text-xs text-primary-200"><a href="/" class="hover:text-white">Home</a><ChevronRightIcon Class="h-3 w-3" /><span>Reconciliation</span><ChevronRightIcon Class="h-3 w-3" /><span>@FunctionName(_run.Function)</span></div>
        <div class="flex flex-wrap items-center justify-between gap-5">
            <div class="flex items-center gap-4">
                <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-white/15 shadow-sm">
                    @if (_run.Function == ReconFunction.AtmToGl) { <RocketIcon Class="h-7 w-7" /> }
                    else if (_run.Function == ReconFunction.PosToGl) { <TableRowIcon Class="h-7 w-7" /> }
                    else if (_run.Function == ReconFunction.NetworkToAtm) { <RocketIcon Class="h-7 w-7" /> }
                    else { <ChartIcon Class="h-7 w-7" /> }
                </div>
                <div><p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary-200">Reconciliation batch</p><h1 class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl">@FunctionName(_run.Function) · batch #@_run.ReconRunId</h1><p class="mt-1 text-sm text-primary-100">@PeriodLabel(_run) · @_run.Status</p></div>
            </div>
            <div class="rounded-xl bg-white/12 px-4 py-3 text-right"><p class="text-xs font-semibold uppercase tracking-wide text-primary-200">Average confidence</p><p class="mt-1 text-2xl font-bold">@_run.AverageConfidence.ToString("0.0")%</p></div>
        </div>
    </section>

    @if (SourcePeriodAdjusted)
    {
        <div role="status" class="mb-5 rounded-xl border border-blue-200 bg-blue-50 p-4 text-sm text-blue-900 dark:border-blue-800 dark:bg-blue-950 dark:text-blue-200">Period set to @PeriodLabel(_run) using processing/posting dates inside the uploaded files.</div>
    }

    @if (_run.Function == ReconFunction.InterchangeToGl && _run.Status == ReconRunStatus.Completed && _run.GlBatchId is not null)
    {
        <a href="@($"/recon/run/{RunId}/matching-review")" class="mb-5 inline-flex items-center gap-2 rounded-lg border border-violet-200 bg-violet-50 px-4 py-2 text-sm font-semibold text-violet-800 hover:bg-violet-100 dark:border-violet-900 dark:bg-violet-950/30 dark:text-violet-200"><ChartIcon Class="h-4 w-4" />AI Analysis</a>
    }

    <div class="verification-panel mb-5 flex flex-wrap items-center justify-between gap-3 rounded-xl border px-4 py-3">
        <div class="flex items-center gap-3"><span class="verification-panel-icon flex h-10 w-10 shrink-0 items-center justify-center rounded-xl"><CheckCircleIcon Class="h-5 w-5" /></span><div><p class="verification-panel-eyebrow text-xs font-semibold uppercase tracking-wide">Verification workflow</p><p class="verification-panel-text mt-1 text-sm font-semibold">@VerificationText()</p>@if (!string.IsNullOrWhiteSpace(_run.ResponsibleActor)) { <p class="verification-panel-subtext mt-0.5 text-xs">Responsible role(s): @_run.ResponsibleActor</p> }</div></div>
        @if (_run.AnalysisOfRunId == null && _run.VerificationStatus == ReconVerificationStatus.NotSubmitted)
        {
            <button type="button" @onclick="SubmitForVerification" disabled="@_submitting" class="rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-700 disabled:opacity-50">Submit for verification</button>
        }
        else if (_run.VerificationStatus == ReconVerificationStatus.AwaitingVerification && _canVerify)
        {
            <button type="button" @onclick="VerifyCurrentStep" disabled="@_submitting" class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700 disabled:opacity-50">Verify current step</button>
        }
    </div>
    @if (_verificationError is not null) { <p class="-mt-3 mb-4 text-sm text-red-600">@_verificationError</p> }
    @if (_run.AnalysisOfRunId is int originalRunId)
    {
        <div class="mb-4 rounded-xl border border-primary-200 bg-primary-50 p-4 text-sm dark:border-primary-800 dark:bg-primary-950/30">
            <p class="font-semibold">Analysis of <a class="text-primary-700 underline dark:text-primary-300" href="@($"/recon/run/{originalRunId}")">batch #@originalRunId</a></p>
            <p class="mt-1">These are separate test results. The original matches, review history and approvals are unchanged.</p>
        </div>
    }
    @if (_canSecondaryMatch && _run.Function == ReconFunction.InterchangeToGl)
    {
        <div class="mb-5 rounded-xl border border-gray-200 p-4 dark:border-gray-700">
            <button type="button" @onclick="RerunAnalysis" disabled="@(_secondaryBusy || _submitting || _archiving || _run.Status != ReconRunStatus.Completed)"
                    class="rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-700 disabled:opacity-50">Re-run analysis (all stages)</button>
            <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Uses stored TRX and GL rows. Runs initial matching, Date/Amount/Currency, Card Number and Previous/Next Period into new analysis results. No upload required.</p>
            @if (_analyses.Count > 0)
            {
                <ul class="mt-3 space-y-1 text-sm">
                    @foreach (var replay in _analyses)
                    {
                        <li @key="replay.ReconRunId"><a class="font-semibold text-primary-700 underline dark:text-primary-300" href="@($"/recon/run/{replay.ReconRunId}")">Analysis #@replay.ReconRunId</a> · @replay.Status · @replay.MatchedCount.ToString("N0") matched · @replay.ExceptionCount.ToString("N0") exceptions · @replay.StartedDate?.ToLocalTime().ToString("dd MMM yyyy HH:mm")</li>
                    }
                </ul>
            }
        </div>
    }
    @if (_passes.Count > 0)
    {
        <div class="mb-5 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm dark:border-emerald-900 dark:bg-emerald-950/30">
            <p class="font-semibold text-emerald-900 dark:text-emerald-200">@(_run.AnalysisOfRunId is null ? "Refinements applied to this batch" : "Analysis stages")</p>
            <ul class="mt-2 space-y-1">
                @foreach (var p in _passes)
                {
                    <li @key="p.ReconRunPassId" class="flex items-center gap-2">
                        <CheckCircleIcon Class="h-4 w-4 shrink-0 text-emerald-600" />
                        <span>@PassName(p.Kind): <span class="font-semibold">@p.Added</span> match@(p.Added == 1 ? "" : "es")@(p.Ambiguous > 0 ? $", {p.Ambiguous} to review" : "") — @p.RunAt.ToLocalTime().ToString("dd MMM HH:mm")</span>
                        @if (_run.AnalysisOfRunId is not null) { <span class="text-xs text-gray-600 dark:text-gray-300">@p.Detail</span> }
                    </li>
                }
            </ul>
        </div>
    }
    @if (_secondaryResult is not null)
    {
        <p role="status" class="mb-4 rounded-lg bg-emerald-100 px-3 py-2 text-sm font-medium text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-200">@_secondaryResult</p>
    }
    @if (_secondaryError is not null)
    {
        <p role="status" class="mb-4 text-sm text-red-600">@_secondaryError</p>
    }
    @if (_canSecondaryMatch && _run.Function == ReconFunction.InterchangeToGl && _run.AnalysisOfRunId is null)
    {
        var busy = _secondaryBusy || _submitting || _archiving || _run.Status != ReconRunStatus.Completed || _run.IsArchived || _run.VerificationStatus != ReconVerificationStatus.NotSubmitted;
        <div class="mb-5 flex flex-wrap items-center gap-3 text-sm">
            @if (PassDone(ReconPassKind.SecondaryAmount))
            {
                <span class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-100 px-3 py-2 font-semibold text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-200"><CheckCircleIcon Class="h-4 w-4" /> Date/Amount/Cur processed (@PassAdded(ReconPassKind.SecondaryAmount))</span>
            }
            else
            {
                <button type="button" @onclick="RunSecondaryMatching" disabled="@busy" class="rounded-lg bg-primary-600 px-4 py-2 font-semibold text-white hover:bg-primary-700 disabled:opacity-50">Match Date/Amount/Cur</button>
            }
            @if (PassDone(ReconPassKind.CardNumber))
            {
                <span class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-100 px-3 py-2 font-semibold text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-200"><CheckCircleIcon Class="h-4 w-4" /> Card number processed (@PassAdded(ReconPassKind.CardNumber))</span>
            }
            else
            {
                <button type="button" @onclick="RunCardMatching" disabled="@busy" class="rounded-lg bg-primary-600 px-4 py-2 font-semibold text-white hover:bg-primary-700 disabled:opacity-50">Match with Card Number</button>
            }
            @if (PassDone(ReconPassKind.CrossPeriod))
            {
                <span class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-100 px-3 py-2 font-semibold text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-200"><CheckCircleIcon Class="h-4 w-4" /> Previous/Next period processed (@PassAdded(ReconPassKind.CrossPeriod))</span>
            }
            else
            {
                <button type="button" @onclick="RunAdjacentMatching" disabled="@busy" class="rounded-lg bg-primary-600 px-4 py-2 font-semibold text-white hover:bg-primary-700 disabled:opacity-50">Match Previous/Next Period</button>
            }
        </div>
    }
    @if (_secondaryBusy)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-sm">
            <div class="flex flex-col items-center gap-3 rounded-2xl bg-white px-8 py-6 shadow-xl dark:bg-gray-800">
                <RefreshIcon Class="h-8 w-8 animate-spin text-primary-600" />
                <p class="text-sm font-semibold text-gray-900 dark:text-white">@(_secondaryProgress ?? "Working…")</p>
                <p class="text-xs text-gray-500 dark:text-gray-400">Please wait — do not navigate away.</p>
            </div>
        </div>
    }
    <div class="mb-5 flex flex-wrap justify-end gap-2">
        @if (_canArchive) { <button type="button" @onclick="ArchiveBatch" disabled="@_archiving" class="rounded-lg border border-amber-400 px-3 py-2 text-sm font-semibold text-amber-800 hover:bg-amber-50 disabled:opacity-50 dark:text-amber-200">Archive this batch</button> }
        @if (_canFreeze) { <button type="button" @onclick="FreezePeriod" disabled="@_archiving" class="rounded-lg bg-slate-800 px-3 py-2 text-sm font-semibold text-white hover:bg-slate-700 disabled:opacity-50">Freeze period and archive runs</button> }
    </div>
    @if (_archiveError is not null) { <p class="-mt-3 mb-4 text-sm text-red-600">@_archiveError</p> }

    <!-- Run-level indicators remain visible while reviewing either source or reconciliation data. -->
    @if (_interchangeAudit is not null)
    {
        <div class="mb-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
            <div class="recon-card recon-card--exception rounded-xl p-4 shadow-sm"><div class="flex items-center gap-2"><span class="recon-card-icon recon-card-icon--red rounded-xl p-2"><ChartIcon Class="h-4 w-4" /></span><p class="text-xs font-semibold uppercase tracking-wide">Row difference</p></div><p class="mt-2 text-3xl font-bold text-rose-600 dark:text-rose-300">@_interchangeAudit.RowDifference.ToString("N0")</p><p class="recon-card-muted mt-1 text-xs">Interchange @_interchangeAudit.InterchangeRows.ToString("N0") · GL @_interchangeAudit.GlRows.ToString("N0")</p></div>
            <div class="recon-card recon-card--duplicate rounded-xl p-4 shadow-sm"><div class="flex items-center gap-2"><span class="recon-card-icon recon-card-icon--amber rounded-xl p-2"><ExclamationTriangleIcon Class="h-4 w-4" /></span><p class="text-xs font-semibold uppercase tracking-wide">Interchange duplicates</p></div><p class="mt-2 text-3xl font-bold text-amber-600 dark:text-amber-300">@_interchangeAudit.InterchangeDuplicateGroups.ToString("N0")</p><p class="recon-card-muted mt-1 text-xs">duplicate references · @_interchangeAudit.InterchangeExtraRows.ToString("N0") extra rows</p></div>
            <div class="recon-card recon-card--duplicate rounded-xl p-4 shadow-sm"><div class="flex items-center gap-2"><span class="recon-card-icon recon-card-icon--amber rounded-xl p-2"><ListIcon Class="h-4 w-4" /></span><p class="text-xs font-semibold uppercase tracking-wide">GL duplicates</p></div><p class="mt-2 text-3xl font-bold text-amber-600 dark:text-amber-300">@_interchangeAudit.GlDuplicateGroups.ToString("N0")</p><p class="recon-card-muted mt-1 text-xs">duplicate references · @_interchangeAudit.GlExtraRows.ToString("N0") extra rows</p></div>
            <div class="recon-card recon-card--info rounded-xl p-4 shadow-sm"><div class="flex items-center gap-2"><span class="recon-card-icon recon-card-icon--blue rounded-xl p-2"><ListIcon Class="h-4 w-4" /></span><p class="text-xs font-semibold uppercase tracking-wide">Duplicate information</p></div><p class="mt-2 text-sm font-medium text-slate-800 dark:text-slate-100">Review every repeated reference and its underlying source rows.</p><button type="button" @onclick="OpenDuplicateDrawer" class="recon-card-button mt-3 rounded-lg px-3 py-2 text-xs font-semibold">View duplicate info</button></div>
        </div>
    }
    <div class="mb-5 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-5">
        <StatCard Label="Processor txns" Value="@_run.ProcessorCount.ToString("N0")" Accent="green"><Icon><TableRowIcon Class="h-5 w-5" /></Icon></StatCard>
        <StatCard Label="Matched" Value="@_run.MatchedCount.ToString("N0")" Hint="@MatchPct()" Accent="green"><Icon><CheckCircleIcon Class="h-5 w-5" /></Icon></StatCard>
        <StatCard Label="Processor exceptions" Value="@_processorExceptionCount.ToString("N0")" Hint="amount mismatch or no GL match" Accent="red"><Icon><ExclamationTriangleIcon Class="h-5 w-5" /></Icon></StatCard>
        <StatCard Label="GL-only entries" Value="@_glOnlyExceptionCount.ToString("N0")" Hint="GL entries with no processor match" Accent="amber"><Icon><ExclamationTriangleIcon Class="h-5 w-5" /></Icon></StatCard>
        <StatCard Label="Avg confidence" Value="@($"{_run.AverageConfidence:0.0}%")" Hint="matched rows" Accent="violet"><Icon><ChartIcon Class="h-5 w-5" /></Icon></StatCard>
    </div>
    @if (_run.Function is ReconFunction.AtmToGl or ReconFunction.NetworkToAtm && _networkValidationTotal > 0)
    {
        <div class="mb-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
            <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 shadow-sm dark:border-emerald-900 dark:bg-emerald-950/30"><p class="text-xs font-semibold uppercase tracking-wide text-emerald-700 dark:text-emerald-300">T464 validated</p><p class="mt-2 text-3xl font-bold text-emerald-950 dark:text-emerald-100">@_networkMatched.ToString("N0")</p><p class="mt-1 text-xs text-emerald-800 dark:text-emerald-200">unique references agree in amount, currency, and fee</p></div>
            <div class="rounded-xl border border-red-200 bg-red-50 p-4 shadow-sm dark:border-red-900 dark:bg-red-950/30"><p class="text-xs font-semibold uppercase tracking-wide text-red-700 dark:text-red-300">Value mismatches</p><p class="mt-2 text-3xl font-bold text-red-950 dark:text-red-100">@_networkMismatches.ToString("N0")</p><p class="mt-1 text-xs text-red-800 dark:text-red-200">amount, fee, or currency differs</p></div>
            <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 shadow-sm dark:border-amber-900 dark:bg-amber-950/30"><p class="text-xs font-semibold uppercase tracking-wide text-amber-700 dark:text-amber-300">One-sided references</p><p class="mt-2 text-3xl font-bold text-amber-950 dark:text-amber-100">@_networkOneSided.ToString("N0")</p><p class="mt-1 text-xs text-amber-800 dark:text-amber-200">present in only T464 or ATM settlement</p></div>
            <div class="rounded-xl border border-violet-200 bg-violet-50 p-4 shadow-sm dark:border-violet-900 dark:bg-violet-950/30"><p class="text-xs font-semibold uppercase tracking-wide text-violet-700 dark:text-violet-300">Duplicate references</p><p class="mt-2 text-3xl font-bold text-violet-950 dark:text-violet-100">@_networkDuplicates.ToString("N0")</p><p class="mt-1 text-xs text-violet-800 dark:text-violet-200">require group-level review</p></div>
        </div>
    }
    @if (_glOnlyTotal > 0)
    {
        <div class="mb-5 grid gap-4 sm:grid-cols-2">
            <div class="rounded-xl border border-red-200 bg-red-50 p-4 shadow-sm dark:border-red-900 dark:bg-red-950/30"><p class="text-xs font-semibold uppercase tracking-wide text-red-700 dark:text-red-300">GL-only transaction refs</p><p class="mt-2 text-3xl font-bold text-red-950 dark:text-red-100">@_glOnlyTransactionCount.ToString("N0")</p><p class="mt-1 text-xs text-red-800 dark:text-red-200">@_glOnlyTransactionAmount.ToString("N2") amount · GL refs not found in processor file</p><button type="button" @onclick='() => OpenGlOnlyDrawer("transaction")' class="mt-3 rounded-lg border border-red-300 px-3 py-2 text-xs font-semibold text-red-800 hover:bg-red-100 dark:border-red-800 dark:text-red-200 dark:hover:bg-red-900/40">View records</button></div>
            <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 shadow-sm dark:border-amber-900 dark:bg-amber-950/30"><p class="text-xs font-semibold uppercase tracking-wide text-amber-700 dark:text-amber-300">GL settlement/bulk postings</p><p class="mt-2 text-3xl font-bold text-amber-950 dark:text-amber-100">@_glOnlySettlementPostingCount.ToString("N0")</p><p class="mt-1 text-xs text-amber-800 dark:text-amber-200">@_glOnlySettlementPostingAmount.ToString("N2") amount · daily settlement or no transaction reference</p><button type="button" @onclick='() => OpenGlOnlyDrawer("settlement")' class="mt-3 rounded-lg border border-amber-300 px-3 py-2 text-xs font-semibold text-amber-800 hover:bg-amber-100 dark:border-amber-800 dark:text-amber-200 dark:hover:bg-amber-900/40">View records</button></div>
        </div>
    }

    <!-- Tabs -->
    <div class="mb-5 flex gap-1 border-b border-gray-200 dark:border-gray-700">
        <button type="button" @onclick="() => SelectTab(Tab.Reconciliation)" class="@TabClass(Tab.Reconciliation)">
            Reconciliation
        </button>
        @if (_run.Function == ReconFunction.AtmToGl && _networkValidationTotal > 0)
        {
            <button type="button" @onclick="() => SelectTab(Tab.NetworkValidation)" class="@TabClass(Tab.NetworkValidation)">
                Network validation <span class="ml-1 text-xs text-gray-400">@_networkValidationTotal.ToString("N0")</span>
            </button>
        }
        @if (_run.Function == ReconFunction.NetworkToAtm)
        {
            <button type="button" @onclick="() => SelectTab(Tab.NetworkTransactions)" class="@TabClass(Tab.NetworkTransactions)">
                T464 transactions <span class="ml-1 text-xs text-gray-400">@_networkTrxTotal.ToString("N0")</span>
            </button>
            <button type="button" @onclick="() => SelectTab(Tab.Transactions)" class="@TabClass(Tab.Transactions)">
                ATM transactions <span class="ml-1 text-xs text-gray-400">@_trxTotal.ToString("N0")</span>
            </button>
        }
        else
        {
            <button type="button" @onclick="() => SelectTab(Tab.Transactions)" class="@TabClass(Tab.Transactions)">
                Transactions <span class="ml-1 text-xs text-gray-400">@_trxTotal.ToString("N0")</span>
            </button>
            @if (_run.Function == ReconFunction.InterchangeToGl)
            {
                <button type="button" @onclick="() => SelectTab(Tab.OnUsAtmTransactions)" class="@TabClass(Tab.OnUsAtmTransactions)">
                    On-Us ATM transactions <span class="ml-1 text-xs text-gray-400">@_onUsAtmTotal.ToString("N0")</span>
                </button>
            }
        }
        @if (_run.GlBatchId is not null)
        {
            <button type="button" @onclick="() => SelectTab(Tab.Gl)" class="@TabClass(Tab.Gl)">
                GL entries <span class="ml-1 text-xs text-gray-400">@_glTotal.ToString("N0")</span>
            </button>
            <button type="button" @onclick="() => SelectTab(Tab.GlBulk)" class="@TabClass(Tab.GlBulk)">
                Bulk postings <span class="ml-1 text-xs text-gray-400">@_glBulkTotal.ToString("N0")</span>
            </button>
        }
    </div>

    @if (_tab == Tab.OnUsAtmTransactions)
    {
        <div class="mb-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-900 dark:bg-amber-950/30 dark:text-amber-200">
            <span class="font-semibold">Excluded from reconciliation.</span> These On-Us ATM withdrawals have Origin code 0 and are not posted to the GL.
        </div>
    }

    @if ((_tab == Tab.Reconciliation && _run.Function == ReconFunction.NetworkToAtm) || _tab == Tab.NetworkValidation)
    {
        <div class="mb-5 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-200 px-5 py-3 dark:border-gray-700">
                <div><h2 class="text-sm font-semibold text-gray-900 dark:text-white">T464 network validation</h2><p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">Network settlement compared with the uploaded ATM settlement by reference.</p></div>
                <!-- Filters Toolbar as per the main recon page -->
                <div class="flex flex-wrap items-center gap-2 text-sm">
                    <input @bind="_networkSearchFilter" @bind:event="oninput" @bind:after="LoadNetworkValidationAsync" placeholder="Search ref or narrative" class="w-44 rounded-lg border border-gray-300 bg-gray-50 px-2.5 py-1.5 text-xs text-gray-900 dark:border-gray-600 dark:bg-gray-700 dark:text-white" />
                    <select value="@_networkStatusFilter" @onchange="SetNetworkStatusFilter" class="rounded-lg border border-gray-300 bg-gray-50 px-2.5 py-1.5 text-xs text-gray-900 dark:border-gray-600 dark:bg-gray-700 dark:text-white">
                        <option value="">All outcomes</option>
                        @foreach (var status in Enum.GetValues<AtmNetworkValidationStatus>())
                        {
                            <option value="@status">@NetworkStatusText(status)</option>
                        }
                    </select>
                    <select value="@_networkNetworkCcyFilter" @onchange='e => SetNetworkNetworkCcy(e.Value?.ToString() ?? "")' class="rounded-lg border border-gray-300 bg-gray-50 px-2.5 py-1.5 text-xs text-gray-900 dark:border-gray-600 dark:bg-gray-700 dark:text-white">
                        <option value="">All T464 currencies</option>
                        @foreach (var ccy in CurrencyOptions())
                        {
                            <option value="@ccy">@CcyName(ccy)</option>
                        }
                    </select>
