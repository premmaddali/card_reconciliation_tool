    private async Task SetMatchGlCcy(string value) { _matchGlCcyFilter = value; await ReloadMatches(); }

    private async Task ReloadExceptions()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var q = db.ReconExceptions.Where(e => e.ReconRunId == RunId);
        if (_filterType >= 0) q = q.Where(e => e.ExceptionType == (MatchStatus)_filterType);
        if (_filterStatus >= 0) q = q.Where(e => e.Status == (ExceptionStatus)_filterStatus);
        if (int.TryParse(_exceptionCcyFilter, out var ccy)) q = q.Where(e => e.Ccy == ccy);
        if (!string.IsNullOrWhiteSpace(_exceptionReferenceFilter)) q = q.Where(e => e.ReferenceNumber != null && e.ReferenceNumber.Contains(_exceptionReferenceFilter));
        _exceptionTotal = await q.CountAsync();
        _exceptions = await q.OrderByDescending(e => e.ExceptionType == MatchStatus.AmountMismatch)
            .ThenBy(e => e.ReconExceptionId).Take(ExcCap).ToListAsync();
    }

    private async Task OpenException(ReconException e)
    {
        _selected = e; _evidenceOnly = false; _newComment = "";
        await using var db = await DbFactory.CreateDbContextAsync();
        _comments = await db.ReconExceptionComments.Where(c => c.ReconExceptionId == e.ReconExceptionId)
            .OrderBy(c => c.CreatedDate).ToListAsync();
        _processorEvidence = null;
        _glEvidence = null;
        if (_run is null) return;

        var match = await db.ReconMatches.Where(m => m.ReconRunId == RunId && m.ReferenceNumber == e.ReferenceNumber)
            .OrderByDescending(m => m.MatchStatus == MatchStatus.AmountMismatch).FirstOrDefaultAsync();
        await LoadEvidenceAsync(db, match, e.ReferenceNumber, e.GlAccountNumber);
    }

    private async Task OpenMatchEvidence(ReconMatch match)
    {
        _evidenceOnly = true;
        _comments = new();
        _newComment = "";
        _selected = new ReconException { ReferenceNumber = match.ReferenceNumber, ExceptionType = match.MatchStatus, Confidence = match.Confidence, ActualAmount = match.ReconciliationAmount, ExpectedAmount = match.GlAmount, Ccy = match.Ccy, TxnDate = match.ProcessorDate, Narrative = MatchDecision(match) };
        await using var db = await DbFactory.CreateDbContextAsync();
        await LoadEvidenceAsync(db, match, match.ReferenceNumber, match.GlAccountNumber);
    }

    private async Task LoadEvidenceAsync(Recon.Web.Data.AppDbContext db, ReconMatch? match, string? reference, string? glAccountNumber)
    {
        if (_run is null) return;
        _processorEvidence = null;
        _glEvidence = null;
        var processorFile = await db.ImportBatches.Where(b => b.ImportBatchId == _run.ProcessorBatchId).Select(b => b.FileName).FirstOrDefaultAsync() ?? "Processor workbook";
        var glFile = await db.ImportBatches.Where(b => b.ImportBatchId == _run.GlBatchId).Select(b => b.FileName).FirstOrDefaultAsync() ?? "GL workbook";

        if (match?.ProcessorSource == StagingSource.InterchangeFee)
        {
            var p = await db.StgInterchangeFees.FirstOrDefaultAsync(x => x.StgInterchangeFeeId == match.ProcessorStagingId);
            if (p is not null) _processorEvidence = new(processorFile, p.SourceRowNumber, p.ReferenceNumber,
                AmountCcy(p.TxnAmount, p.TxnCcy), AmountCcy(p.BillingAmount, p.BillingCcy), AmountCcy(p.SettlementAmount, p.SettlementCcy), p.TransactionWording);
        }
        else if (match is not null)
        {
            var p = await db.StgDebitSettlements.FirstOrDefaultAsync(x => x.StgDebitSettlementId == match.ProcessorStagingId);
            if (p is not null) _processorEvidence = new(processorFile, p.SourceRowNumber, p.ReferenceNumber,
                AmountCcy(p.TxnAmount, p.TxnCcy), AmountCcy(p.BillingAmount, p.BillingCcy), AmountCcy(p.SettlementAmount, p.SettlementCcy), p.TransactionWording);
        }

        var gl = match?.GlStagingId is int glId
            ? await db.StgGlEntries.FirstOrDefaultAsync(x => x.StgGlEntryId == glId)
            : await db.StgGlEntries.FirstOrDefaultAsync(x => x.ImportBatchId == _run.GlBatchId && x.TranParticular2 == reference && (glAccountNumber == null || x.AcctNum == glAccountNumber));
        if (gl is not null)
        {
            var evidenceFile = gl.ImportBatchId == _run.GlBatchId ? glFile
                : await db.ImportBatches.Where(x => x.ImportBatchId == gl.ImportBatchId).Select(x => x.FileName).FirstOrDefaultAsync() ?? glFile;
            _glEvidence = new(evidenceFile, gl.SourceRowNumber, gl.TranParticular2, gl.AcctNum,
                gl.TranAmt?.ToString("N2") ?? "—", gl.TranParticular);
        }
    }

