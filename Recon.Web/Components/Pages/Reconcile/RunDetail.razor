    private async Task SaveManualGlMatch()
    {
        if (_run?.AnalysisOfRunId is not null) { _manualGlError = "Analysis results cannot create operational GL entries."; return; }
        var grants = await Permissions.GetGrantsAsync(CurrentUser.UserId);
        if (!grants.TryGetValue("MANUAL_GL_MATCH", out var grant) || !grant.CanEdit)
        {
            _manualGlError = "You do not have permission to create a manual GL match.";
            return;
        }
        if (_manualGlMatchId is null || string.IsNullOrWhiteSpace(_manualGlAccount) || string.IsNullOrWhiteSpace(_manualGlReference) || _manualGlAmount is null || string.IsNullOrWhiteSpace(_manualGlComment))
        {
            _manualGlError = "GL account, reference, amount, and a reason are required.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var match = await db.ReconMatches.SingleOrDefaultAsync(m => m.ReconMatchId == _manualGlMatchId && m.ReconRunId == RunId);
        if (match is null || !CanAddManualGl(match))
        {
            _manualGlError = "This row is no longer eligible for a manual GL match.";
            return;
        }

        var exception = await db.ReconExceptions.Where(e => e.ReconRunId == RunId && e.ExceptionType == MatchStatus.UnmatchedProcessor && e.Status != ExceptionStatus.Resolved && e.ReferenceNumber == match.ReferenceNumber && e.SettlementLeg == match.SettlementLeg).OrderByDescending(e => e.ReconExceptionId).FirstOrDefaultAsync();
        if (exception is null)
        {
            _manualGlError = "The linked No GL Match exception could not be found, so this resolution cannot be audited.";
            return;
        }

        var reason = _manualGlComment.Trim();
        match.GlAccountNumber = _manualGlAccount.Trim();
        match.GlReference = _manualGlReference.Trim();
        match.GlParticular2 = _manualGlReference.Trim();
        match.GlDescription = string.IsNullOrWhiteSpace(_manualGlDescription) ? null : _manualGlDescription.Trim();
        match.GlAmount = Math.Round(_manualGlAmount.Value, 4);
        match.GlCcy = _manualGlCcy;
        match.GlDate = _manualGlDate;
        match.MatchStatus = MatchStatus.Matched;
        match.IsManuallyMatched = true;
        match.ManuallyMatchedDate = DateTime.UtcNow;
        match.MatchComment = reason;
        match.ScoreBreakdown = "Manual GL match: " + reason;
        match.Confidence = 100m;

        exception.Status = ExceptionStatus.Resolved;
        exception.ResolvedBy = CurrentUser.UserId;
        exception.ResolvedDate = DateTime.UtcNow;
        db.ReconExceptionComments.Add(new ReconExceptionComment { ReconExceptionId = exception.ReconExceptionId, Body = $"[Manual GL match] GL account {_manualGlAccount.Trim()}, reference {_manualGlReference.Trim()}, date {_manualGlDate:yyyy-MM-dd}, amount {_manualGlAmount.Value:N2} ({CcyName(_manualGlCcy)}). Reason: {reason}" });

        await db.SaveChangesAsync();
        await RebuildSummariesAsync(db);
        var run = await db.ReconRuns.FindAsync(RunId);
        if (run is not null)
        {
            run.MatchedCount = await db.ReconMatches.CountAsync(m => m.ReconRunId == RunId && m.MatchStatus == MatchStatus.Matched);
            run.ExceptionCount = await db.ReconExceptions.CountAsync(e => e.ReconRunId == RunId && e.Status != ExceptionStatus.Resolved);
            await db.SaveChangesAsync();
        }
        _run = run;
        CloseManualGlDrawer();
        await ReloadMatches();
    }

