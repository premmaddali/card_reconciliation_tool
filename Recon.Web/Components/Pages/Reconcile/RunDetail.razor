    private string DataFilterValue(string column) => _dataFilters.GetValueOrDefault(column, "");
    private string DataFilterMode(string column) => _dataFilterModes.GetValueOrDefault(column, "contains");

    private IQueryable<T> ApplyTextFilter<T>(IQueryable<T> query, string column, System.Linq.Expressions.Expression<Func<T, string?>> property)
    {
        var mode = DataFilterMode(column);
        var value = DataFilterValue(column);
        if (mode == "contains" && string.IsNullOrWhiteSpace(value)) return query;

        var parameter = property.Parameters[0];
        var propertyValue = property.Body;
        var isNull = System.Linq.Expressions.Expression.Equal(propertyValue, System.Linq.Expressions.Expression.Constant(null, propertyValue.Type));
        var isEmpty = System.Linq.Expressions.Expression.Equal(propertyValue, System.Linq.Expressions.Expression.Constant("", typeof(string)));
        System.Linq.Expressions.Expression predicate = mode switch
        {
            "blank" => System.Linq.Expressions.Expression.OrElse(isNull, isEmpty),
            "not_blank" => System.Linq.Expressions.Expression.Not(System.Linq.Expressions.Expression.OrElse(isNull, isEmpty)),
            _ => System.Linq.Expressions.Expression.AndAlso(
                System.Linq.Expressions.Expression.NotEqual(propertyValue, System.Linq.Expressions.Expression.Constant(null, propertyValue.Type)),
                System.Linq.Expressions.Expression.Call(propertyValue, nameof(string.Contains), Type.EmptyTypes, System.Linq.Expressions.Expression.Constant(value)))
        };
        return query.Where(System.Linq.Expressions.Expression.Lambda<Func<T, bool>>(predicate, parameter));
    }

    private async Task SetDataFilter(string column, ChangeEventArgs args)
    {
        var value = args.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(value)) _dataFilters.Remove(column);
        else _dataFilters[column] = value;
        await ApplyDataFilters();
    }

    private async Task SetDataFilterMode(string column, ChangeEventArgs args)
    {
        var mode = args.Value?.ToString() ?? "contains";
        if (mode == "contains") _dataFilterModes.Remove(column);
        else _dataFilterModes[column] = mode;
        await ApplyDataFilters();
    }

    private async Task ReloadReconciliation()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var q = db.ReconPassSummaries.Where(s => s.ReconRunId == RunId && s.Day == null);
        if (int.TryParse(_summaryCcyFilter, out var ccy)) q = q.Where(s => s.Ccy == ccy);
        await LoadMonthlySummariesAsync(db, q);
    }

    // Older runs can contain a legacy daily no-date summary in addition to monthly (both Day = null).
    // Display one monthly row per bucket; newly created/rebuilt runs no longer generate that duplicate.
    private async Task LoadMonthlySummariesAsync(Recon.Web.Data.AppDbContext db, IQueryable<ReconPassSummary>? query = null)
    {
        var rows = await (query ?? db.ReconPassSummaries.Where(s => s.ReconRunId == RunId && s.Day == null)).ToListAsync();
        _monthly = rows.GroupBy(s => (s.SettlementLeg, s.Ccy)).Select(g => g.OrderByDescending(s => s.ReconPassSummaryId).First()).OrderBy(s => s.SettlementLeg).ThenBy(s => s.Ccy).ToList();
    }

    private async Task ReloadMatches()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var q = db.ReconMatches.Where(m => m.ReconRunId == RunId);
        q = ApplyMatchResultFilter(q, _matchFilter);
        if (!string.IsNullOrWhiteSpace(_matchSearchFilter)) q = q.Where(m =>
            (m.ReferenceNumber != null && m.ReferenceNumber.Contains(_matchSearchFilter)) ||
            (m.ProcessorMerchant != null && m.ProcessorMerchant.Contains(_matchSearchFilter)));
        if (!string.IsNullOrWhiteSpace(_matchReferenceFilter)) q = q.Where(m => m.ReferenceNumber != null && m.ReferenceNumber.Contains(_matchReferenceFilter));
        if (!string.IsNullOrWhiteSpace(_matchMicrofilmFilter)) q = q.Where(m => m.MicrofilmRefNumber != null && m.MicrofilmRefNumber.Contains(_matchMicrofilmFilter));
        if (!string.IsNullOrWhiteSpace(_matchGlParticular2Filter)) q = q.Where(m => m.GlParticular2 != null && m.GlParticular2.Contains(_matchGlParticular2Filter));
        if (!string.IsNullOrWhiteSpace(_matchProcessorAccountFilter)) q = q.Where(m => m.ProcessorAccountNumber != null && m.ProcessorAccountNumber.Contains(_matchProcessorAccountFilter));
        if (_matchCardTypeFilter == "blank") q = q.Where(m => m.ProcessorProductType == null || m.ProcessorProductType == "");
        else if (!string.IsNullOrWhiteSpace(_matchCardTypeFilter)) q = q.Where(m => m.ProcessorProductType != null && m.ProcessorProductType == _matchCardTypeFilter);
        if (!string.IsNullOrWhiteSpace(_matchMerchantFilter)) q = q.Where(m => m.ProcessorMerchant != null && m.ProcessorMerchant.Contains(_matchMerchantFilter));
        if (_matchProcessorDescriptionFilter == "blank") q = q.Where(m => m.ProcessorDescription == null || m.ProcessorDescription == "");
        else if (!string.IsNullOrWhiteSpace(_matchProcessorDescriptionFilter)) q = q.Where(m => m.ProcessorDescription == _matchProcessorDescriptionFilter);
        if (!string.IsNullOrWhiteSpace(_matchGlAccountFilter)) q = q.Where(m => m.GlAccountNumber != null && m.GlAccountNumber.Contains(_matchGlAccountFilter));
        if (int.TryParse(_matchTxnCcyFilter, out var txnCcy)) q = q.Where(m => m.ProcessorCcy == txnCcy);
        if (int.TryParse(_matchBillingCcyFilter, out var billingCcy)) q = q.Where(m => m.BillingCcy == billingCcy);
        if (int.TryParse(_matchSettlementCcyFilter, out var settlementCcy)) q = q.Where(m => m.SettlementCcy == settlementCcy);
        if (_matchOtherReconCcy) q = q.Where(m => m.Ccy == null || (m.Ccy != 480 && m.Ccy != 840 && m.Ccy != 978));
        else if (int.TryParse(_matchReconCcyFilter, out var reconCcy)) q = q.Where(m => m.Ccy == reconCcy);
        if (byte.TryParse(_matchLegFilter, out var leg)) q = q.Where(m => m.SettlementLeg == (ReconSettlementLeg)leg);
        if (int.TryParse(_matchGlCcyFilter, out var glCcy)) q = q.Where(m => (m.GlCcy ?? 480) == glCcy);
        if (_matchProcessorDateFilter is { } processorDate)
        {
            var dayStart = processorDate.ToDateTime(TimeOnly.MinValue);
            var dayEnd = dayStart.AddDays(1);
            q = q.Where(m => (m.ProcessorTransactionDateTime != null && m.ProcessorTransactionDateTime >= dayStart && m.ProcessorTransactionDateTime < dayEnd) || m.ProcessorDate == processorDate);
        }
        if (_matchGlDateFilter is { } glDate) q = q.Where(m => m.GlDate == glDate);
        if (_matchGlPostingDateFilter is { } postingDate)
        {
            var dayStart = postingDate.ToDateTime(TimeOnly.MinValue);
            var dayEnd = dayStart.AddDays(1);
            q = q.Where(m => m.GlPostingDateTime >= dayStart && m.GlPostingDateTime < dayEnd);
        }
        if (decimal.TryParse(_maxDifference, out var maxDifference))
            q = q.Where(m => m.ReconciliationAmount != null && m.GlAmount != null && Math.Abs(m.ReconciliationAmount.Value - m.GlAmount.Value) <= maxDifference);
        _matchTotal = await q.CountAsync();
        if (_matchPage >= MatchPageCount) _matchPage = 0;
        q = _matchSort switch
        {
            "date" when _matchSortDescending => q.OrderByDescending(m => m.ProcessorTransactionDateTime).ThenByDescending(m => m.ProcessorDate).ThenByDescending(m => m.ReconMatchId),
            "date" => q.OrderBy(m => m.ProcessorTransactionDateTime).ThenBy(m => m.ProcessorDate).ThenBy(m => m.ReconMatchId),
            "gl_date" when _matchSortDescending => q.OrderByDescending(m => m.GlDate).ThenByDescending(m => m.GlPostingDateTime).ThenByDescending(m => m.ReconMatchId),
            "gl_date" => q.OrderBy(m => m.GlDate).ThenBy(m => m.GlPostingDateTime).ThenBy(m => m.ReconMatchId),
            "gl_posting" when _matchSortDescending => q.OrderByDescending(m => m.GlPostingDateTime).ThenByDescending(m => m.GlDate).ThenByDescending(m => m.ReconMatchId),
            "gl_posting" => q.OrderBy(m => m.GlPostingDateTime).ThenBy(m => m.GlDate).ThenBy(m => m.ReconMatchId),
            "difference" when _matchSortDescending => q.OrderByDescending(m => m.ReconciliationAmount != null && m.GlAmount != null ? Math.Abs(m.ReconciliationAmount.Value - m.GlAmount.Value) : -1m).ThenByDescending(m => m.ReconMatchId),
            "difference" => q.OrderBy(m => m.ReconciliationAmount != null && m.GlAmount != null ? Math.Abs(m.ReconciliationAmount.Value - m.GlAmount.Value) : decimal.MaxValue).ThenBy(m => m.ReconMatchId),
            "confidence" when _matchSortDescending => q.OrderByDescending(m => m.Confidence).ThenByDescending(m => m.ProcessorTransactionDateTime).ThenByDescending(m => m.ReconMatchId),
            "confidence" => q.OrderBy(m => m.Confidence).ThenBy(m => m.ProcessorTransactionDateTime).ThenBy(m => m.ReconMatchId),
            _ => q.OrderByDescending(m => m.ReconMatchId)
        };
        _matches = await q.Skip(_matchPage * MatchPageSize).Take(MatchPageSize).ToListAsync();
        var processorCurrencies = await db.ReconMatches.Where(m => m.ReconRunId == RunId && m.ProcessorCcy != null)
            .Select(m => m.ProcessorCcy!.Value).ToListAsync();
        var billingCurrencies = await db.ReconMatches.Where(m => m.ReconRunId == RunId && m.BillingCcy != null)
            .Select(m => m.BillingCcy!.Value).ToListAsync();
        var settlementCurrencies = await db.ReconMatches.Where(m => m.ReconRunId == RunId && m.SettlementCcy != null)
            .Select(m => m.SettlementCcy!.Value).ToListAsync();
        var reconciliationCurrencies = await db.ReconMatches.Where(m => m.ReconRunId == RunId && m.Ccy != null)
            .Select(m => m.Ccy!.Value).ToListAsync();
        _matchCurrencies = processorCurrencies.Concat(billingCurrencies).Concat(settlementCurrencies)
            .Concat(reconciliationCurrencies).Append(480).Distinct().OrderBy(c => c).ToList();
        _selectedMatchIds.IntersectWith(_matches.Select(m => m.ReconMatchId));
    }

