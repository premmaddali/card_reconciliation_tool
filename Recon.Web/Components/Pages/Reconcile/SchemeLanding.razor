@page "/recon"
@using Microsoft.EntityFrameworkCore
@using Recon.Web.Platform.Model
@attribute [Authorize]
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<Recon.Web.Data.AppDbContext> DbFactory
@inject Recon.Web.Services.IPermissionService Permissions
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>Reconciliation · Recon Tool</PageTitle>

<PageHeader Title="Reconciliation" Subtitle="Choose a payment scheme to run or review reconciliations" Eyebrow="Overview" Icon="bulk" />

<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    @foreach (var scheme in _schemes)
    {
        <div class="scheme-card @SchemeCardClass(scheme.Scheme) flex flex-col gap-4 rounded-2xl border p-5 transition-all hover:-translate-y-0.5 hover:border-primary-300 hover:shadow-lg dark:hover:border-primary-700">
            <div class="flex items-center gap-3">
                <div class="scheme-logo @SchemeClass(scheme.Scheme) flex h-12 w-12 shrink-0 items-center justify-center rounded-xl shadow-inner" title="@scheme.Scheme">
                    <TableRowIcon Class="h-6 w-6" />
                </div>
                <div class="min-w-0">
                    <p class="truncate text-base font-bold text-gray-900 dark:text-white">@scheme.Scheme</p>
                    <p class="mt-0.5 truncate text-xs text-gray-500 dark:text-gray-400">@scheme.Cms</p>
                </div>
            </div>
            @* Direct links to each function's actual recon screen. *@
            <div class="mt-auto flex flex-col gap-1.5">
                @foreach (var fn in scheme.Items)
                {
                    <a href="@fn.Route" class="scheme-action group inline-flex items-center justify-between gap-3 rounded-xl border px-3 py-2.5 text-sm font-semibold transition-all">
                        <span class="flex min-w-0 items-center gap-2.5"><span class="scheme-action-icon flex h-7 w-7 shrink-0 items-center justify-center rounded-lg">@FunctionIcon(fn.Function)</span><span>@fn.Label</span></span>
                        <span class="scheme-action-arrow flex h-6 w-6 shrink-0 items-center justify-center rounded-full transition-transform group-hover:translate-x-0.5"><ArrowRightIcon Class="h-3.5 w-3.5" /></span>
                    </a>
                }
            </div>
        </div>
    }
    @if (_schemes.Count == 0)
    {
        <div class="col-span-full rounded-xl border border-dashed border-gray-300 bg-gray-50 p-10 text-center text-sm text-gray-500 dark:border-gray-600 dark:bg-gray-800/50 dark:text-gray-400">
            No active schemes configured. Enable a scheme profile in configuration.
        </div>
    }
</div>

@code {
    private sealed record FunctionLink(string Function, string Label, string Route);
    private sealed record SchemeCard(int SchemeProfileId, string Scheme, string Cms, List<FunctionLink> Items);

    private List<SchemeCard> _schemes = [];

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var userId = Guid.TryParse(state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : Guid.Empty;
        await Permissions.GetGrantsAsync(userId);

        await using var db = await DbFactory.CreateDbContextAsync();
        var profiles = await db.SchemeProfiles.Where(p => p.IsActive).OrderBy(p => p.Scheme).ToListAsync();

        // A scheme card is visible when the user can view at least one of its enabled functions.
        _schemes = profiles
            .Select(p => new SchemeCard(p.SchemeProfileId, p.Scheme, p.Cms, FunctionLinks(p)))
            .Where(c => c.Items.Any())
            .ToList();
    }

    /// <summary>One link per enabled function, pointing at the scheme's actual recon screen
    /// (Mastercard uses the original pages; other schemes the generic per-scheme page).</summary>
    private List<FunctionLink> FunctionLinks(SchemeProfile p)
    {
        var links = new List<FunctionLink>();
        foreach (var fn in p.Functions.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var route = fn switch
            {
                "AtmToGl" when p.Scheme == "Mastercard" => "/recon/atm",
                "PosToGl" when p.Scheme == "Mastercard" => "/recon/pos",
                "InterchangeToGl" when p.Scheme == "Mastercard" => "/recon/bulk",
                "NetworkToAtm" when p.Scheme == "Mastercard" => "/recon/network-atm",
                _ => $"/recon/scheme/{p.SchemeProfileId}/{fn}"
            };
            links.Add(new FunctionLink(fn, LabelFor(fn), route));
        }
        return links;
    }

    internal static string LabelFor(string function) => function switch
    {
        "AtmToGl" => "ATM recon",
        "PosToGl" => "POS recon",
        "InterchangeToGl" => "Bulk recon",
        "NetworkToAtm" => "Network ↔ ATM recon",
        _ => function
    };

    private static string SchemeClass(string scheme) => scheme.ToLowerInvariant() switch
    {
        "mastercard" => "scheme-logo--mastercard",
        "visa" => "scheme-logo--visa",
        "unionpay" => "scheme-logo--unionpay",
        "rupay" => "scheme-logo--rupay",
        _ => "scheme-logo--domestic"
    };

    private static string SchemeCardClass(string scheme) => scheme.ToLowerInvariant() switch
    {
        "mastercard" => "scheme-card--mastercard",
        "visa" => "scheme-card--visa",
        "unionpay" => "scheme-card--unionpay",
        "rupay" => "scheme-card--rupay",
        _ => "scheme-card--domestic"
    };

    private RenderFragment FunctionIcon(string function) => function switch
    {
        "AtmToGl" => @<RocketIcon Class="h-4 w-4" />,
        "PosToGl" => @<TableRowIcon Class="h-4 w-4" />,
        "InterchangeToGl" => @<ChartIcon Class="h-4 w-4" />,
        "NetworkToAtm" => @<RocketIcon Class="h-4 w-4" />,
        _ => @<ChartIcon Class="h-4 w-4" />
    };
}
