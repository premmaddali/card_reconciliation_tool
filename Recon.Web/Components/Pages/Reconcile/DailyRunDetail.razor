@page "/recon/daily/{ContainerId:int}"
@attribute [Authorize]
@inject IDbContextFactory<Recon.Web.Data.AppDbContext> DbFactory
@inject Recon.Web.Services.Import.IImportService ImportService
@inject Recon.Web.Services.Recon.IReconEngine Engine
@inject Recon.Web.Services.Recon.DailyReconService Daily
@inject Recon.Web.Services.IPermissionService Permissions
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@using Microsoft.EntityFrameworkCore
@using Recon.Web.Domain.Import
@using Recon.Web.Domain.Recon
@using Recon.Web.Services.Import
@using Recon.Web.Services.Recon

<PageTitle>@(_container?.PeriodKey ?? "Month") · Daily recon</PageTitle>
<PageHeader Title="@($"Daily recon · {_container?.PeriodKey}")" Subtitle="Add a date-range run (a day, two days, a whole month). Each load also reconciles pending past transactions left unmatched by earlier loads, within the settlement window." Eyebrow="Reconciliation" Icon="bulk"
            Breadcrumbs="@(new[] { "Reconciliation", "Daily / period recon", _container?.PeriodKey ?? "" })" />

@if (_container is null)
{
    <p class="text-sm text-gray-500 dark:text-gray-400">Loading…</p>
}
else
{
    <div class="mb-4 flex flex-wrap items-center gap-3 text-sm">
        <a href="/recon/daily" class="text-primary-700 hover:underline dark:text-primary-300">← All months</a>
        <span class="rounded-full px-2 py-0.5 text-xs font-semibold @(_container.Status == ReconPeriodRunStatus.Open ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300" : "bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-300")">@(_container.Status == ReconPeriodRunStatus.Open ? "Open" : "Rolled up")</span>
        <span class="text-gray-500 dark:text-gray-400">Settlement spread: <span class="font-semibold text-gray-700 dark:text-gray-200">@_spread days</span></span>
    </div>

    <div class="mb-6 grid gap-4 sm:grid-cols-3">
        <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Matched</p>
            <p class="mt-1 text-2xl font-bold tabular-nums text-emerald-700 dark:text-emerald-300">@_matched.ToString("N0")</p>
        </div>
        <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Outstanding</p>
            <p class="mt-1 text-2xl font-bold tabular-nums text-amber-700 dark:text-amber-300">@_outstanding.ToString("N0")</p>
            <p class="mt-0.5 text-[11px] text-gray-400">unmatched, still within the spread</p>
        </div>
        <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Aged</p>
            <p class="mt-1 text-2xl font-bold tabular-nums text-red-700 dark:text-red-300">@_aged.ToString("N0")</p>
            <p class="mt-0.5 text-[11px] text-gray-400">unmatched beyond the spread</p>
        </div>
    </div>

    @if (_container.Status == ReconPeriodRunStatus.RolledUp)
    {
        <div class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-gray-200 bg-gray-50 p-4 dark:border-gray-700 dark:bg-gray-800">
            <p class="text-sm text-gray-700 dark:text-gray-200">This month was consolidated into month batch <a href="/recon/run/@_container.RolledUpRunId" class="font-semibold text-primary-700 hover:underline dark:text-primary-300">#@_container.RolledUpRunId</a>. The date-range runs are read-only history.</p>
            <a href="/recon/run/@_container.RolledUpRunId" class="inline-flex items-center rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-700">Open month batch</a>
        </div>
    }
    else if (_runs.Count > 0 && _canRollUp)
    {
        <div class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-primary-200 bg-primary-50 p-4 dark:border-primary-800 dark:bg-primary-950/30">
            <p class="text-sm text-primary-900 dark:text-primary-100">When this month is complete, consolidate its date-range runs into a single canonical month batch. Late settlement from the next month can still reconcile into it.</p>
            <button type="button" disabled="@_busy" @onclick="RollUp" class="inline-flex shrink-0 items-center rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-700 disabled:opacity-50">Roll up month</button>
        </div>
    }

    <div class="grid gap-6 lg:grid-cols-5">
        <div class="lg:col-span-2">
            <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-700 dark:bg-gray-800">
                <h2 class="mb-4 text-sm font-semibold text-gray-900 dark:text-white">Add date-range run</h2>
                <div class="mb-4 grid grid-cols-2 gap-3">
                    <div>
                        <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">From</label>
                        <input type="date" @bind="_from" disabled="@(_busy || _container.Status != ReconPeriodRunStatus.Open)" class="w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2 text-sm text-gray-900 dark:border-gray-600 dark:bg-gray-700 dark:text-white" />
                    </div>
                    <div>
                        <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">To</label>
                        <input type="date" @bind="_to" disabled="@(_busy || _container.Status != ReconPeriodRunStatus.Open)" class="w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2 text-sm text-gray-900 dark:border-gray-600 dark:bg-gray-700 dark:text-white" />
                    </div>
                </div>

                <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Interchange (TRX) file</label>
                <div class="mb-4 flex min-w-0 items-center gap-3">
                    <InputFile id="trx-upload" OnChange="e => _trxFile = e.File" accept=".xlsx,.csv" disabled="@_busy" class="sr-only" />
                    <label for="trx-upload" class="inline-flex shrink-0 cursor-pointer items-center rounded-lg bg-primary-600 px-3.5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-primary-700 @(_busy ? "pointer-events-none opacity-50" : "")">Choose file</label>
                    <span class="min-w-0 truncate text-sm @(_trxFile is null ? "text-gray-400" : "text-emerald-600 dark:text-emerald-400")">@(_trxFile?.Name ?? "No file selected")</span>
                </div>

                <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">GL dump file</label>
                <div class="mb-4 flex min-w-0 items-center gap-3">
                    <InputFile id="gl-upload" OnChange="e => _glFile = e.File" accept=".xlsx,.csv" disabled="@_busy" class="sr-only" />
                    <label for="gl-upload" class="inline-flex shrink-0 cursor-pointer items-center rounded-lg bg-primary-600 px-3.5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-primary-700 @(_busy ? "pointer-events-none opacity-50" : "")">Choose file</label>
                    <span class="min-w-0 truncate text-sm @(_glFile is null ? "text-gray-400" : "text-emerald-600 dark:text-emerald-400")">@(_glFile?.Name ?? "No file selected")</span>
                </div>

                @if (_error is not null)
                {
                    <div class="mb-3 flex items-start gap-2 rounded-lg border border-red-200 bg-red-50 p-3 text-xs text-red-700 dark:border-red-900 dark:bg-red-900/30 dark:text-red-300">
                        <ExclamationTriangleIcon Class="mt-0.5 h-4 w-4 shrink-0" /><span>@_error</span>
                    </div>
                }
                <button type="button" disabled="@(_busy || _trxFile is null || _glFile is null || _container.Status != ReconPeriodRunStatus.Open)"
                        class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-primary-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-primary-700 disabled:cursor-not-allowed disabled:opacity-50" @onclick="AddRun">
                    <PlayIcon Class="h-4 w-4" /><span>Run reconciliation</span>
                </button>

                @if (_container.Status == ReconPeriodRunStatus.Open && _runs.Count > 0)
                {
                    <button type="button" disabled="@_busy" @onclick="BackMatchOnly"
                            class="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-lg border border-primary-300 px-4 py-2 text-sm font-semibold text-primary-700 hover:bg-primary-50 disabled:opacity-50 dark:border-primary-700 dark:text-primary-300 dark:hover:bg-primary-950/30">
                        Reconcile pending past transactions
                    </button>
                }
            </div>
        </div>

        <div class="lg:col-span-3 space-y-6">
            <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">
                <div class="border-b border-gray-200 px-5 py-3 dark:border-gray-700"><h2 class="text-sm font-semibold text-gray-900 dark:text-white">Date-range runs in this month</h2></div>
                <table class="w-full text-left text-sm">
                    <thead class="text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">
                        <tr class="border-b border-gray-100 dark:border-gray-700">
                            <th class="px-5 py-2.5 font-semibold">Range</th>
                            <th class="px-5 py-2.5 text-right font-semibold">Matched</th>
                            <th class="px-5 py-2.5 text-right font-semibold">Outstanding</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                        @if (_runs.Count == 0)
                        {
                            <tr><td colspan="3" class="px-5 py-10 text-center text-gray-500 dark:text-gray-400">No runs yet — add one on the left.</td></tr>
                        }
                        @foreach (var r in _runs)
                        {
                            <tr @key="r.Id" class="cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700/40" @onclick="() => OpenRun(r.Id)">
                                <td class="px-5 py-3 font-semibold text-primary-700 dark:text-primary-300">@r.Range</td>
                                <td class="px-5 py-3 text-right tabular-nums text-emerald-700 dark:text-emerald-300">@r.Matched.ToString("N0")</td>
                                <td class="px-5 py-3 text-right tabular-nums text-amber-700 dark:text-amber-300">@r.Exceptions.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">
                <div class="flex flex-wrap items-center justify-between gap-2 border-b border-gray-200 px-5 py-3 dark:border-gray-700">
                    <div>
                        <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Pending past transactions reconciled</h2>
                        <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">Transactions matched to a GL entry that arrived in a later load (a different day or an adjacent month), by the period they belong to.</p>
                    </div>
                    <button type="button" @onclick="OpenDrawer" disabled="@(_reconciledTotal == 0)"
                            class="inline-flex shrink-0 items-center gap-2 rounded-full bg-emerald-100 px-3.5 py-1.5 text-sm font-bold text-emerald-700 hover:bg-emerald-200 disabled:cursor-default disabled:opacity-60 dark:bg-emerald-900/40 dark:text-emerald-300 dark:hover:bg-emerald-900/60">
                        @_reconciledTotal.ToString("N0")@if (_reconciledTotal > 0) { <span class="text-xs font-semibold uppercase tracking-wide">View</span> }
                    </button>
                </div>

                @if (_lastResult is not null)
                {
                    <p class="px-5 pt-3 text-xs @(_lastResult.Added > 0 ? "text-emerald-700 dark:text-emerald-300" : "text-gray-500 dark:text-gray-400")">
                        Last run: @(_lastResult.Added > 0 ? $"reconciled {_lastResult.Added:N0} more" : "no new matches")@(_lastResult.Ambiguous > 0 ? $" · {_lastResult.Ambiguous} need review" : "").
                    </p>
                }

                @if (_reconciledByPeriod.Count == 0)
                {
                    <p class="px-5 py-8 text-center text-sm text-gray-500 dark:text-gray-400">None yet — these appear once a later load reconciles an earlier outstanding transaction.</p>
                }
                else
                {
                    <table class="mt-1 w-full text-left text-sm">
                        <thead class="text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">
                            <tr class="border-b border-gray-100 dark:border-gray-700">
                                <th class="px-5 py-2.5 font-semibold">Period</th>
                                <th class="px-5 py-2.5 text-right font-semibold">Transactions reconciled</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                            @foreach (var p in _reconciledByPeriod)
                            {
                                <tr @key="p.Period"><td class="px-5 py-3 text-gray-700 dark:text-gray-200">@p.Period</td><td class="px-5 py-3 text-right tabular-nums font-semibold text-emerald-700 dark:text-emerald-300">@p.Count.ToString("N0")</td></tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    @if (_drawerOpen)
    {
        <div class="fixed inset-0 z-40 bg-gray-950/50 backdrop-blur-sm" @onclick="CloseDrawer"></div>
        <div class="fixed inset-y-0 right-0 z-50 flex w-full max-w-2xl flex-col bg-white shadow-2xl dark:bg-gray-900">
            <div class="flex items-center justify-between border-b border-gray-200 px-5 py-4 dark:border-gray-700">
                <div>
                    <h2 class="text-base font-bold text-gray-900 dark:text-white">Pending past transactions reconciled</h2>
                    <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">@_reconciledTotal.ToString("N0") total@(_reconciledTotal > _reconciled.Count ? $" · showing the latest {_reconciled.Count:N0}" : "").</p>
                </div>
                <button type="button" @onclick="CloseDrawer" class="rounded-lg px-3 py-2 text-sm font-semibold text-gray-500 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800" aria-label="Close">Close ✕</button>
            </div>
            <div class="flex-1 overflow-y-auto">
                <table class="w-full text-left text-sm">
                    <thead class="sticky top-0 bg-gray-50 text-xs uppercase tracking-wider text-gray-500 dark:bg-gray-800 dark:text-gray-400">
                        <tr class="border-b border-gray-100 dark:border-gray-700">
                            <th class="px-5 py-2.5 font-semibold">Reference</th>
                            <th class="px-5 py-2.5 text-right font-semibold">Amount</th>
                            <th class="px-5 py-2.5 font-semibold">Ccy</th>
                            <th class="px-5 py-2.5 font-semibold">Transaction date</th>
                            <th class="px-5 py-2.5 font-semibold">GL value date</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                        @foreach (var r in _reconciled)
                        {
                            <tr @key="r.Reference + r.GlValueDate?.ToString()">
                                <td class="px-5 py-2.5 font-mono text-xs text-gray-700 dark:text-gray-200">@(string.IsNullOrEmpty(r.Reference) ? "—" : r.Reference)</td>
                                <td class="px-5 py-2.5 text-right tabular-nums text-gray-700 dark:text-gray-200">@(r.Amount?.ToString("N2") ?? "—")</td>
                                <td class="px-5 py-2.5 text-gray-500 dark:text-gray-400">@CcyText(r.Ccy)</td>
                                <td class="px-5 py-2.5 text-gray-700 dark:text-gray-200">@(r.TxnDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                <td class="px-5 py-2.5 text-gray-700 dark:text-gray-200">@(r.GlValueDate?.ToString("dd MMM yyyy") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@if (_busy && _progressStep > 0)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-gray-950/60 p-4 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="daily-progress-title">
        <div class="w-full max-w-2xl rounded-2xl border border-primary-200 bg-white p-6 shadow-2xl dark:border-primary-800 dark:bg-gray-900 sm:p-7" role="status" aria-live="polite">
            <div class="flex items-start gap-4">
                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-primary-600 text-white shadow-sm"><RefreshIcon Class="h-7 w-7 animate-spin" /></div>
                <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center justify-between gap-2"><h2 id="daily-progress-title" class="text-lg font-bold text-gray-900 dark:text-white">@_busyStage</h2><span class="rounded-full bg-primary-100 px-2.5 py-1 text-xs font-semibold text-primary-700 dark:bg-primary-900/40 dark:text-primary-200">Step @_progressStep of 4</span></div>
                    <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">@_progress</p>
                </div>
            </div>

            @if (_progressStep == 3 && _reconTotal > 0)
            {
                <div class="mt-5 rounded-xl bg-primary-50 px-4 py-3 text-center dark:bg-primary-950/30"><p class="text-2xl font-bold tabular-nums text-primary-800 dark:text-primary-200">@_reconProcessed.ToString("N0") <span class="text-base font-medium">of</span> @_reconTotal.ToString("N0")</p><p class="mt-0.5 text-xs font-semibold uppercase tracking-wide text-primary-700 dark:text-primary-300">records processed · @_reconMatched.ToString("N0") matched</p></div>
            }

            <div class="mt-5 h-3 overflow-hidden rounded-full bg-primary-100 dark:bg-primary-950"><div class="h-full rounded-full bg-primary-600 transition-all duration-500" style="width: @ProgressPercent"></div></div>
            <div class="mt-4 grid grid-cols-4 gap-2 text-center text-xs font-semibold">
                <div class="@ProgressStepClass(1)"><span class="mx-auto mb-1 flex h-6 w-6 items-center justify-center rounded-full border text-xs">@(_progressStep > 1 ? "✓" : "1")</span>TRX file</div>
                <div class="@ProgressStepClass(2)"><span class="mx-auto mb-1 flex h-6 w-6 items-center justify-center rounded-full border text-xs">@(_progressStep > 2 ? "✓" : "2")</span>GL file</div>
                <div class="@ProgressStepClass(3)"><span class="mx-auto mb-1 flex h-6 w-6 items-center justify-center rounded-full border text-xs">@(_progressStep > 3 ? "✓" : "3")</span>Match records</div>
                <div class="@ProgressStepClass(4)"><span class="mx-auto mb-1 flex h-6 w-6 items-center justify-center rounded-full border text-xs">4</span>Reconcile pending</div>
            </div>

            @if (_awaitingDuplicateConfirmation)
            {
                <div class="mt-5 rounded-xl border border-primary-200 bg-primary-50 p-4 dark:border-primary-800 dark:bg-primary-950/30">
                    <p class="text-sm font-bold text-primary-950 dark:text-primary-100">Unique-reference pass complete</p>
                    <p class="mt-1 text-sm text-primary-800 dark:text-primary-200">@_reconMatched.ToString("N0") clean one-to-one records have been matched. Continue to check duplicate, ambiguous, and reference-less records.</p>
                    <button type="button" class="mt-4 inline-flex items-center rounded-lg bg-primary-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-primary-700" @onclick="ContinueWithAmbiguousRecords">Continue with duplicates &amp; ambiguous records</button>
                </div>
            }
        </div>
    </div>
}
else if (_busy)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-gray-950/60 p-4 backdrop-blur-sm" role="dialog" aria-modal="true">
        <div class="w-full max-w-md rounded-2xl border border-primary-200 bg-white p-6 text-center shadow-2xl dark:border-primary-800 dark:bg-gray-900">
            <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-primary-600 text-white"><RefreshIcon Class="h-7 w-7 animate-spin" /></div>
            <h2 class="text-lg font-bold text-gray-900 dark:text-white">@_busyStage</h2>
            <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">Please wait — do not close this tab.</p>
        </div>
    </div>
}

@code {
    [Parameter] public int ContainerId { get; set; }
    private record RunRow(int Id, string Range, int Matched, int Exceptions, DateTime Created);
    private record ReconciledRow(string? Reference, decimal? Amount, int? Ccy, DateOnly? TxnDate, DateOnly? GlValueDate);

    private ReconPeriodRun? _container;
    private int _spread = 20;
    private int _matched, _outstanding, _aged, _reconciledTotal;
    private List<ReconciledRow> _reconciled = [];
    private List<(string Period, int Count)> _reconciledByPeriod = [];
    private bool _drawerOpen;
    private bool _canRollUp;
    private List<RunRow> _runs = [];
    private DateTime _from = DateTime.Today, _to = DateTime.Today;
    private IBrowserFile? _trxFile, _glFile;
    private bool _busy;
    private string? _busyStage, _error;
    private int _progressStep;
    private int _reconProcessed, _reconTotal, _reconMatched;
    private string? _progress;
    private bool _awaitingDuplicateConfirmation;
    private TaskCompletionSource<bool>? _duplicateConfirmation;
    private DailyBackMatchResult? _lastResult;
    private const long MaxBytes = 200L * 1024 * 1024;

    protected override async Task OnParametersSetAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        if (Guid.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var uid))
        {
            var grants = await Permissions.GetGrantsAsync(uid);
            _canRollUp = grants.TryGetValue("BULKRECON", out var g) && g.CanView && g.CanEdit;
        }
        await Load();
    }

    private async Task Load()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _container = await db.ReconPeriodRuns.FirstOrDefaultAsync(c => c.ReconPeriodRunId == ContainerId);
        if (_container is null) return;
        _spread = await db.ReconParameters.Select(p => p.SettlementSpreadDays).FirstOrDefaultAsync();
        if (_spread <= 0) _spread = 20;
        if (DateOnly.TryParseExact(_container.PeriodKey + "-01", "yyyy-MM-dd", out var first))
        {
            _from = first.ToDateTime(TimeOnly.MinValue);
            _to = _from;
        }
        _runs = await db.ReconRuns.Where(r => r.ParentPeriodRunId == ContainerId && !r.IsArchived)
            .OrderBy(r => r.PeriodStart).ThenBy(r => r.ReconRunId)
            .Select(r => new RunRow(r.ReconRunId,
                r.PeriodStart != null && r.PeriodEnd != null
                    ? (r.PeriodStart == r.PeriodEnd ? r.PeriodStart.Value.ToString("dd MMM yyyy") : $"{r.PeriodStart.Value:dd MMM} – {r.PeriodEnd.Value:dd MMM yyyy}")
                    : r.PeriodKey,
                r.MatchedCount, r.ExceptionCount, r.CreatedDate))
            .ToListAsync();

        // Effective runs for the month's totals: the open children, or the consolidated batch once rolled up.
        var effective = _container.Status == ReconPeriodRunStatus.RolledUp && _container.RolledUpRunId is int rid
            ? new List<int> { rid }
            : _runs.Select(r => r.Id).ToList();
        if (effective.Count > 0)
        {
            _matched = await db.ReconMatches.CountAsync(m => effective.Contains(m.ReconRunId) && m.MatchStatus == MatchStatus.Matched);
            _outstanding = await db.ReconExceptions.CountAsync(e => effective.Contains(e.ReconRunId));
            // Aged: unmatched items whose settlement window closed within the month (date on/before month-end − spread).
            if (DateOnly.TryParseExact(_container.PeriodKey + "-01", "yyyy-MM-dd", out var f))
            {
                var cutoff = f.AddMonths(1).AddDays(-1).AddDays(-_spread);
                _aged = await db.ReconExceptions.CountAsync(e => effective.Contains(e.ReconRunId) && e.TxnDate != null && e.TxnDate <= cutoff);
            }
            _reconciledTotal = await db.ReconMatches.CountAsync(m => effective.Contains(m.ReconRunId) && m.MatchStatus == MatchStatus.Matched && m.MatchedAcrossPeriods);
            var rows = await db.ReconMatches
                .Where(m => effective.Contains(m.ReconRunId) && m.MatchStatus == MatchStatus.Matched && m.MatchedAcrossPeriods)
                .OrderByDescending(m => m.GlValueDate)
                .Select(m => new { m.ReferenceNumber, m.ReconciliationAmount, m.Ccy, m.ProcessorTransactionDateTime, m.ProcessorDate, m.GlValueDate })
                .Take(200).ToListAsync();
            _reconciled = rows.Select(m => new ReconciledRow(m.ReferenceNumber, m.ReconciliationAmount, m.Ccy,
                m.ProcessorTransactionDateTime != null ? DateOnly.FromDateTime(m.ProcessorTransactionDateTime.Value) : m.ProcessorDate,
                m.GlValueDate)).ToList();

            // Cumulative per-period breakdown, straight from the DB — never cleared by a later run.
            var labelMap = _runs.ToDictionary(r => r.Id, r => r.Range);
            if (_container.Status == ReconPeriodRunStatus.RolledUp && _container.RolledUpRunId is int rrid)
                labelMap[rrid] = _container.PeriodKey;
            var grouped = await db.ReconMatches
                .Where(m => effective.Contains(m.ReconRunId) && m.MatchStatus == MatchStatus.Matched && m.MatchedAcrossPeriods)
                .GroupBy(m => m.ReconRunId).Select(g => new { g.Key, Count = g.Count() }).ToListAsync();
            _reconciledByPeriod = grouped
                .Select(g => (Period: labelMap.GetValueOrDefault(g.Key, $"run #{g.Key}"), g.Count))
                .OrderBy(x => x.Period).ToList();
        }
        else { _matched = _outstanding = _aged = _reconciledTotal = 0; _reconciled = []; _reconciledByPeriod = []; }
    }

    private void OpenDrawer() { if (_reconciledTotal > 0) _drawerOpen = true; }
    private void CloseDrawer() => _drawerOpen = false;

    private static string CcyText(int? ccy) => ccy switch { 480 => "MUR", 840 => "USD", 978 => "EUR", null => "—", _ => ccy.ToString()! };

    private async Task RollUp()
    {
        _error = null; _busy = true; _busyStage = "Consolidating the month…";
        try
        {
            await Daily.RollUpAsync(ContainerId);
            await Load();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; _busyStage = null; }
    }

    private async Task AddRun()
    {
        _error = null;
        if (_trxFile is null || _glFile is null || _container is null) return;
        var from = DateOnly.FromDateTime(_from);
        var to = DateOnly.FromDateTime(_to);
        if (to < from) { _error = "'To' must be on or after 'From'."; return; }

        _busy = true;
        _reconProcessed = _reconTotal = _reconMatched = 0;
        try
        {
            _progressStep = 1; _busyStage = "Processing reconciliation"; _progress = "Importing the interchange (TRX) file…";
            StateHasChanged();
            var trx = await Import(_trxFile);
            if (!trx.Success) { _error = trx.Error; return; }
            if (trx.DetectedType != SourceType.InterchangeFee) { _error = $"That file was detected as {trx.DetectedType}, but an Interchange (TRX) file is expected."; return; }

            _progressStep = 2; _progress = "Importing the GL dump…";
            StateHasChanged();
            var gl = await Import(_glFile);
            if (!gl.Success) { _error = gl.Error; return; }
            if (gl.DetectedType != SourceType.GlDump) { _error = $"The GL slot received a {gl.DetectedType} file — upload the GL dump."; return; }

            _progressStep = 3; _progress = "Matching records and calculating confidence…";
            StateHasChanged();
            var liveProgress = new Progress<ReconProgress>(p =>
            {
                _progress = p.Stage; _reconProcessed = p.Processed; _reconTotal = p.Total; _reconMatched = p.Matched;
                _ = InvokeAsync(StateHasChanged);
            });
            // Date-range runs intentionally use a sub-month window; posting dates may lag past it.
            var run = await Engine.RunAsync(ReconFunction.InterchangeToGl, trx.ImportBatchId!.Value, gl.ImportBatchId!.Value,
                _container.PeriodKey, from, to, default, liveProgress, PauseBeforeAmbiguousPassAsync, null, false, 0m, enforcePostingPeriod: false);

            // Tag the run as a date-range child of this month container.
            await using (var db = await DbFactory.CreateDbContextAsync())
            {
                await db.ReconRuns.Where(r => r.ReconRunId == run.ReconRunId)
                    .ExecuteUpdateAsync(s => s
                        .SetProperty(r => r.ParentPeriodRunId, ContainerId)
                        .SetProperty(r => r.PeriodGranularity, from == to ? PeriodGranularity.Day : PeriodGranularity.Range), default);
            }

            _progressStep = 4; _progress = "Reconciling pending past transactions…";
            StateHasChanged();
            _lastResult = await Daily.BackMatchAsync(ContainerId);
            await Load();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally
        {
            _busy = false; _busyStage = _progress = null; _progressStep = 0;
            _reconProcessed = _reconTotal = _reconMatched = 0;
            _awaitingDuplicateConfirmation = false; _duplicateConfirmation = null;
            _trxFile = null; _glFile = null;
        }
    }

    private async Task PauseBeforeAmbiguousPassAsync(ReconProgress p)
    {
        _progress = p.Stage; _reconProcessed = p.Processed; _reconTotal = p.Total; _reconMatched = p.Matched;
        _awaitingDuplicateConfirmation = true;
        _duplicateConfirmation = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
        await InvokeAsync(StateHasChanged);
        await _duplicateConfirmation.Task;
    }

    private Task ContinueWithAmbiguousRecords()
    {
        _awaitingDuplicateConfirmation = false;
        _progress = "Evaluating duplicate and ambiguous records…";
        _duplicateConfirmation?.TrySetResult(true);
        return InvokeAsync(StateHasChanged);
    }

    private string ProgressPercent => _progressStep switch
    {
        1 => "15%",
        2 => "40%",
        3 when _reconTotal > 0 => $"{Math.Min(85, 45 + 40 * _reconProcessed / _reconTotal)}%",
        3 => "45%",
        4 => "92%",
        _ => "0%"
    };
    private string ProgressStepClass(int step) => _progressStep >= step
        ? "text-primary-800 dark:text-primary-200" : "text-gray-400 dark:text-gray-500";

    private async Task BackMatchOnly()
    {
        _error = null;
        _busy = true; _busyStage = "Reconciling pending past transactions…";
        try
        {
            _lastResult = await Daily.BackMatchAsync(ContainerId);
            await Load();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; _busyStage = null; }
    }

    private async Task<ImportOutcome> Import(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(MaxBytes);
        return await ImportService.ImportAsync(stream, file.Name, _container!.PeriodKey);
    }

    private void OpenRun(int id) => Nav.NavigateTo($"/recon/run/{id}");
}
