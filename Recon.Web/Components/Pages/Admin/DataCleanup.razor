@page "/admin/data-cleanup"
@inject Recon.Web.Services.DataCleanupService Cleanup
@inject ILogger<DataCleanup> Logger

<PageTitle>Data cleanup · Recon Tool</PageTitle>
<PageHeader Title="Data cleanup" Subtitle="Clear transaction history while preserving application setup" Eyebrow="Administration" Icon="list"
            Breadcrumbs="@(new[] { "Administration", "Data cleanup" })" />

@if (_allowed)
{
    <div class="max-w-2xl rounded-xl border border-red-200 bg-white p-5 shadow-sm dark:border-gray-700 dark:bg-gray-800">
        <h2 class="text-lg font-semibold">Permanently delete transaction data</h2>
        <label for="cleanup-scope" class="mt-4 block text-sm font-semibold">Cleanup scope</label>
        <select id="cleanup-scope" @bind="_mode" @bind:after="RefreshPreview" disabled="@_busy" class="mt-2 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm dark:border-gray-600 dark:bg-gray-700">
            <option value="before">Clear before a month</option>
            <option value="all">Clear all periods</option>
        </select>
        @if (_mode == "before")
        {
            <label for="cleanup-month" class="mt-4 block text-sm font-semibold">Keep this month and everything after it</label>
            <input id="cleanup-month" type="month" value="@_month" @onchange="MonthChanged" disabled="@_busy" class="mt-2 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm dark:border-gray-600 dark:bg-gray-700" />
            <p class="mt-3 text-sm">Only periods before @_month will be cleared, across all schemes. Selection uses the batch period and reconciliation date range, not the upload date. Date ranges reaching the selected month, records without a valid period, and batches still needed by retained runs are kept.</p>
        }
        else
        {
            <p class="mt-3 text-sm font-semibold">All periods will be cleared across every scheme.</p>
        }
        <p class="mt-3 text-sm">Cleanup includes imported batches, staged transactions, reconciliation runs, matches, exceptions, comments, verification history, archived transactions and frozen periods. It does not distinguish test transactions from live transactions.</p>
        <p class="mt-3 text-sm">Users, roles, access permissions, currencies, GL accounts, scheme profiles, workflow definitions and run parameters are preserved.</p>
        @if (_preview is not null)
        {
            <p class="mt-3 text-sm font-semibold">Selected for deletion: @_preview.Batches batches, @_preview.Runs runs, @_preview.Archives archives.</p>
            @if (_preview.SharedBatchesKept > 0)
            {
                <p class="mt-2 text-sm">@_preview.SharedBatchesKept older batches will be kept because retained runs still use them.</p>
            }
        }
        <p class="mt-3 text-sm text-red-700 dark:text-red-300">This cannot be undone. Take a database backup first and have other users stop imports and reconciliation work until cleanup finishes.</p>
        <label for="cleanup-confirmation" class="mt-5 block text-sm font-semibold">Type @ExpectedConfirmation to confirm</label>
        <input id="cleanup-confirmation" autocomplete="off" @bind="_confirmation" @bind:event="oninput" disabled="@(_busy || _preview is null)"
               class="mt-2 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm dark:border-gray-600 dark:bg-gray-700" />
        <button type="button" @onclick="Clear" disabled="@(_busy || _preview is null || _confirmation != ExpectedConfirmation)"
                class="mt-4 rounded-lg bg-red-700 px-4 py-2 text-sm font-semibold text-white hover:bg-red-800 disabled:opacity-50">
            @(_busy ? "Working…" : "Permanently clear selected transaction data")
        </button>
    </div>
}
@if (_message is not null)
{
    <p role="status" class="mt-4 text-sm">@_message</p>
}

@code {
    private Recon.Web.Services.CleanupPreview? _preview;
    private string _mode = "before";
    private string _month = DateTime.Today.ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture);
    private string _confirmation = "";
    private string? _message;
    private bool _busy;
    private bool _allowed;
    private string? BeforeMonth => _mode == "before" ? _month : null;
    private string ExpectedConfirmation => _mode == "before" ? $"DELETE BEFORE {_month}" : Recon.Web.Services.DataCleanupService.Confirmation;

    protected override Task OnInitializedAsync() => RefreshPreview();

    private async Task MonthChanged(ChangeEventArgs args)
    {
        _month = args.Value?.ToString() ?? "";
        await RefreshPreview();
    }

    private async Task RefreshPreview()
    {
        _confirmation = "";
        _preview = null;
        _message = null;
        _busy = true;
        try { _preview = await Cleanup.PreviewAsync(BeforeMonth); _allowed = true; }
        catch (UnauthorizedAccessException ex) { _allowed = false; _message = ex.Message; }
        catch (InvalidOperationException ex) { _message = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "Cleanup preview failed"); _message = "Unable to load the cleanup preview. Reload the page to retry."; }
        finally { _busy = false; }
    }

    private async Task Clear()
    {
        if (_busy || _preview is null) return;
        _busy = true;
        _message = null;
        try
        {
            var beforeMonth = BeforeMonth;
            await Cleanup.ClearAsync(_confirmation, beforeMonth);
            _preview = null;
            _allowed = false;
            _message = (beforeMonth is null ? "All transaction data has been cleared." : $"Transaction data before {beforeMonth} has been cleared. The selected month, later periods and shared batches needed by retained runs were kept.")
                + " Seed/reference data and application configuration are preserved.";
        }
        catch (UnauthorizedAccessException ex) { _allowed = false; _preview = null; _message = ex.Message; }
        catch (InvalidOperationException ex) { _message = ex.Message; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Transaction cleanup failed");
            _message = "Cleanup failed. No partial cleanup was committed. Check the server logs before retrying.";
        }
        finally { _confirmation = ""; _busy = false; }
    }
}
