@page "/account/password"

<PageTitle>Change password · Recon Tool</PageTitle>

<PageHeader Title="Change password" Subtitle="Update the password for your local Recon Tool account" Eyebrow="Account" Icon="roles" />

<div class="max-w-lg rounded-xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800">
    @if (Changed)
    {
        <div class="mb-5 rounded-lg border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-800 dark:border-emerald-900 dark:bg-emerald-950/30 dark:text-emerald-200">Your password has been changed.</div>
    }
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="mb-5 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700 dark:border-red-900 dark:bg-red-950/30 dark:text-red-300">@ErrorMessage</div>
    }
    <form method="post" action="/auth/change-password" class="space-y-4">
        <AntiforgeryToken />
        <div><label for="currentPassword" class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-300">Current password</label><input id="currentPassword" name="currentPassword" type="password" required autocomplete="current-password" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm dark:border-gray-600 dark:bg-gray-900" /></div>
        <div><label for="newPassword" class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-300">New password</label><input id="newPassword" name="newPassword" type="password" required minlength="8" autocomplete="new-password" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm dark:border-gray-600 dark:bg-gray-900" /></div>
        <div><label for="confirmPassword" class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-300">Confirm new password</label><input id="confirmPassword" name="confirmPassword" type="password" required minlength="8" autocomplete="new-password" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm dark:border-gray-600 dark:bg-gray-900" /></div>
        <button type="submit" class="rounded-lg bg-primary-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-primary-700">Change password</button>
    </form>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "changed")] public string? ChangedValue { get; set; }
    private bool Changed => ChangedValue == "1";
    private string? ErrorMessage => Error switch
    {
        "missing" => "Enter your current password and a new password.",
        "mismatch" => "The new password and confirmation do not match.",
        "provider" => "Password changes are available only for local accounts.",
        "invalid" => "The current password was not accepted, or the new password does not meet the password policy.",
        _ => null
    };
}
