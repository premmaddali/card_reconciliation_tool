@page "/"
@inject IDbContextFactory<Recon.Web.Data.AppDbContext> DbFactory
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@using Microsoft.EntityFrameworkCore
@using Recon.Web.Domain.Import
@using Recon.Web.Domain.Recon

<PageTitle>Dashboard · Recon Tool</PageTitle>

<PageHeader Title="Dashboard" Subtitle="Card reconciliation platform" Eyebrow="Overview" Icon="dashboard" />

<div class="mb-5 flex gap-1 border-b border-gray-200 dark:border-gray-700">
    <button type="button" @onclick='() => _dashboardTab = "overview"' class='@DashboardTabClass("overview")'>Overview</button>
    <button type="button" @onclick='() => _dashboardTab = "awaiting"' class='@DashboardTabClass("awaiting")'>My queue <span class="ml-1 rounded-full bg-primary-100 px-1.5 py-0.5 text-[10px] text-primary-700 dark:bg-primary-900/40 dark:text-primary-200">@_awaiting.Count</span></button>
</div>

@if (_dashboardTab == "overview")
{
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <StatCard Label="Files imported" Value="@_batchCount.ToString()" Hint="staging batches" Accent="blue">
        <Icon><FileImportIcon Class="h-5 w-5" /></Icon>
    </StatCard>
    <StatCard Label="Rows staged" Value="@_rowCount.ToString("N0")" Hint="across all sources" Accent="green">
        <Icon><ListIcon Class="h-5 w-5" /></Icon>
    </StatCard>
    <StatCard Label="Sources loaded" Value="@($"{_sourcesLoaded}/5")" Hint="required file types" Accent="green">
        <Icon><CheckIcon Class="h-5 w-5" /></Icon>
    </StatCard>
    <StatCard Label="Recon runs" Value="@_runCount.ToString()" Hint="reconciliations" Accent="amber">
        <Icon><RefreshIcon Class="h-5 w-5" /></Icon>
    </StatCard>
</div>
<div class="mt-6"><AnalyticsCharts DonutTitle="Completed runs by function" BarTitle="Exceptions by function" Segments="@_runDistribution" Bars="@_exceptionDistribution" /></div>
}
else
{
    <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">
        <div class="border-b border-gray-200 px-5 py-3 dark:border-gray-700"><h2 class="text-sm font-semibold text-gray-900 dark:text-white">Awaiting my verification</h2></div>
        <table class="w-full text-left text-sm"><thead class="text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400"><tr class="border-b border-gray-100 dark:border-gray-700"><th class="px-5 py-2.5">Batch</th><th class="px-5 py-2.5">Function</th><th class="px-5 py-2.5">Period</th><th class="px-5 py-2.5">Next action</th><th class="px-5 py-2.5">Responsible role(s)</th><th class="px-5 py-2.5"></th></tr></thead><tbody class="divide-y divide-gray-100 dark:divide-gray-700">@if (_awaiting.Count == 0) { <tr><td colspan="6" class="px-5 py-10 text-center text-gray-500">No batches are awaiting your verification.</td></tr> } @foreach (var item in _awaiting) { <tr @key="item.RunId"><td class="px-5 py-3 font-semibold text-primary-700">#@item.RunId</td><td class="px-5 py-3">@FunctionName(item.Function)</td><td class="px-5 py-3">@item.Period</td><td class="px-5 py-3">@item.NextAction</td><td class="px-5 py-3">@item.Responsible</td><td class="px-5 py-3 text-right"><button type="button" @onclick="() => Open(item.RunId)" class="rounded-lg bg-primary-600 px-3 py-1.5 text-xs font-semibold text-white">Review</button></td></tr> }</tbody></table>
    </div>
}

@if (_dashboardTab == "overview")
{
<div class="mt-6 grid gap-6 lg:grid-cols-3">
    <div class="lg:col-span-2 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">
        <div class="border-b border-gray-200 px-5 py-3 dark:border-gray-700">
            <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Recent reconciliation runs</h2>
        </div>
        <table class="w-full text-left text-sm">
            <thead class="text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">
                <tr class="border-b border-gray-100 dark:border-gray-700">
                    <th class="px-5 py-2.5 font-semibold">Run</th>
                    <th class="px-5 py-2.5 font-semibold">Function</th>
                    <th class="px-5 py-2.5 text-right font-semibold">Matched</th>
                    <th class="px-5 py-2.5 text-right font-semibold">Exceptions</th>
                    <th class="px-5 py-2.5 text-right font-semibold">Confidence</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                @if (_runs.Count == 0)
                {
                    <tr><td colspan="5" class="px-5 py-8 text-center text-gray-500 dark:text-gray-400">No runs yet — start with <a href="/recon/pos" class="text-primary-600 hover:underline">POS recon</a>.</td></tr>
                }
                @foreach (var r in _runs)
                {
                    <tr @key="r.ReconRunId" class="cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700/40" @onclick="() => Open(r.ReconRunId)">
                        <td class="px-5 py-2.5 font-semibold text-primary-700 dark:text-primary-300">#@r.ReconRunId</td>
                        <td class="px-5 py-2.5 text-gray-700 dark:text-gray-200">@FunctionName(r.Function)</td>
                        <td class="px-5 py-2.5 text-right tabular-nums text-emerald-700 dark:text-emerald-300">@r.MatchedCount.ToString("N0")</td>
                        <td class="px-5 py-2.5 text-right tabular-nums text-red-700 dark:text-red-300">@r.ExceptionCount.ToString("N0")</td>
                        <td class="px-5 py-2.5 text-right tabular-nums text-gray-700 dark:text-gray-200">@r.AverageConfidence.ToString("0.0")%</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-700 dark:bg-gray-800">
        <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Run a reconciliation</h2>
        <div class="mt-3 space-y-2">
            <a href="/recon/atm" class="flex items-center gap-3 rounded-lg border border-gray-200 px-3 py-2.5 text-sm font-medium text-gray-700 hover:border-primary-300 hover:bg-primary-50 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-primary-900/20"><RocketIcon Class="h-5 w-5 text-primary-600" /> ATM recon</a>
            <a href="/recon/pos" class="flex items-center gap-3 rounded-lg border border-gray-200 px-3 py-2.5 text-sm font-medium text-gray-700 hover:border-primary-300 hover:bg-primary-50 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-primary-900/20"><TableRowIcon Class="h-5 w-5 text-primary-600" /> POS recon</a>
            <a href="/recon/bulk" class="flex items-center gap-3 rounded-lg border border-gray-200 px-3 py-2.5 text-sm font-medium text-gray-700 hover:border-primary-300 hover:bg-primary-50 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-primary-900/20"><ChartIcon Class="h-5 w-5 text-primary-600" /> Bulk recon</a>
            <a href="/recon/network-atm" class="flex items-center gap-3 rounded-lg border border-gray-200 px-3 py-2.5 text-sm font-medium text-gray-700 hover:border-primary-300 hover:bg-primary-50 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-primary-900/20"><RocketIcon Class="h-5 w-5 text-primary-600" /> Network ↔ ATM recon</a>
        </div>
        <p class="mt-4 text-xs text-gray-500 dark:text-gray-400">Import the GL dump and a processor file first on the <a href="/import" class="text-primary-600 hover:underline">Import</a> page.</p>
    </div>
</div>
}

@code {
    private int _batchCount, _runCount, _sourcesLoaded;
    private long _rowCount;
    private List<ReconRun> _runs = new();
    private List<AnalyticsSegment> _runDistribution = new();
    private List<AnalyticsBar> _exceptionDistribution = new();
    private sealed record AwaitingItem(int RunId, ReconFunction Function, string Period, string? NextAction, string? Responsible);
    private List<AwaitingItem> _awaiting = new();
    private string _dashboardTab = "overview";

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var parsed = db.ImportBatches.Where(b => b.Status == ImportStatus.Parsed);
        _batchCount = await db.ImportBatches.CountAsync();
        _rowCount = await parsed.SumAsync(b => (long)b.RowCount);
        _sourcesLoaded = await parsed.Select(b => b.SourceType).Distinct().CountAsync();
        _runCount = await db.ReconRuns.CountAsync(r => r.AnalysisOfRunId == null);
        _runs = await db.ReconRuns.Where(r => r.AnalysisOfRunId == null && r.Status == ReconRunStatus.Completed)
            .OrderByDescending(r => r.CreatedDate).Take(8).ToListAsync();
        var completed = await db.ReconRuns.Where(r => r.AnalysisOfRunId == null && r.Status == ReconRunStatus.Completed && !r.IsArchived)
            .Select(r => new { r.Function, r.ExceptionCount }).ToListAsync();
        _runDistribution = completed.GroupBy(r => r.Function).OrderByDescending(g => g.Count())
            .Select((g, i) => new AnalyticsSegment(FunctionName(g.Key), g.LongCount(), ChartColors[i % ChartColors.Length])).ToList();
        _exceptionDistribution = completed.GroupBy(r => r.Function).OrderByDescending(g => g.Sum(x => x.ExceptionCount))
            .Select((g, i) => new AnalyticsBar(FunctionName(g.Key), g.Sum(x => (long)x.ExceptionCount), ChartColors[i % ChartColors.Length])).ToList();

        var state = await AuthState.GetAuthenticationStateAsync();
        var claim = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (Guid.TryParse(claim, out var userId))
        {
            var roleIds = await db.UserAppAccesses.Where(x => x.UserId == userId && x.IsActive).Select(x => x.AppAccessId).ToListAsync();
            // Use EXISTS rather than join + Distinct: SQL Server can translate this reliably and
            // each reconciliation run is returned once even where several of the user's roles
            // are permitted to complete the same verification step.
            _awaiting = await db.ReconRuns
                .Where(run => run.VerificationStatus == ReconVerificationStatus.AwaitingVerification
                    && db.ReconWorkflowActors.Any(actor =>
                        actor.ReconRunId == run.ReconRunId
                        && actor.Status == ReconWorkflowActorStatus.AwaitingAction
                        && roleIds.Contains(actor.AppAccessId)))
                .OrderBy(run => run.PeriodKey)
                .ThenBy(run => run.ReconRunId)
                .Select(run => new AwaitingItem(run.ReconRunId, run.Function, run.PeriodKey, run.NextAction, run.ResponsibleActor))
                .ToListAsync();
        }
    }

    private void Open(int runId) => Nav.NavigateTo($"/recon/run/{runId}");

    private string DashboardTabClass(string tab) => "border-b-2 px-4 py-2 text-sm font-semibold " + (_dashboardTab == tab ? "border-primary-600 text-primary-700 dark:text-primary-200" : "border-transparent text-gray-500 hover:text-gray-700 dark:text-gray-400");

    private static string FunctionName(ReconFunction f) => f switch
    {
        ReconFunction.AtmToGl => "ATM recon",
        ReconFunction.PosToGl => "POS recon",
        ReconFunction.NetworkToAtm => "Network ↔ ATM recon",
        _ => "Bulk recon"
    };
    private static readonly string[] ChartColors = ["#6f982b", "#4f8dcf", "#d19035", "#d25349", "#8d70c9"];
}
