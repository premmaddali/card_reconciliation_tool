@inject IPermissionService Permissions
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<Recon.Web.Data.AppDbContext> DbFactory
@using Recon.Web.Services
@using Microsoft.EntityFrameworkCore

<aside class="flex shrink-0 flex-col border-r border-gray-200 bg-white transition-all duration-200 dark:border-gray-800 dark:bg-gray-900 @(Collapsed ? "w-20" : "w-64")">
    <div class="flex h-16 items-center gap-3 border-b border-gray-200 px-5 dark:border-gray-800">
        <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary-700 text-sm font-bold text-white shadow-sm">
            RT
        </div>
        <div class="leading-tight @(Collapsed ? "hidden" : "")">
            <p class="text-sm font-semibold text-gray-900 dark:text-white">Recon Tool</p>
            <p class="text-[11px] text-gray-500 dark:text-gray-400">Multi-scheme platform</p>
        </div>
    </div>

    <nav class="flex-1 space-y-6 overflow-y-auto px-3 py-5">
        @foreach (var group in _menu.GroupBy(m => new { m.GroupName, m.GroupSequence }).OrderBy(g => g.Key.GroupSequence))
        {
            <div @key="@(group.Key.GroupName ?? "_")">
                @if (group.Key.GroupName is not null)
                {
                    <button type="button" @onclick="() => ToggleGroup(GroupKey(group.Key.GroupName, group.Key.GroupSequence))" title="@(IsGroupExpanded(group.Key.GroupName, group.Key.GroupSequence) ? $"Collapse {group.Key.GroupName}" : $"Expand {group.Key.GroupName}")"
                            class="mb-2 flex w-full items-center gap-2 px-3 text-left text-[11px] font-semibold uppercase tracking-wider text-gray-500 hover:text-gray-800 dark:text-gray-400 dark:hover:text-gray-200 @(Collapsed ? "hidden" : "")">
                        <span class="flex-1">@group.Key.GroupName</span>
                        <svg class="h-4 w-4 shrink-0 transition-transform duration-200 @(IsGroupExpanded(group.Key.GroupName, group.Key.GroupSequence) ? "rotate-90" : "")" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                            <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                        </svg>
                    </button>
                }
                @if (IsGroupExpanded(group.Key.GroupName, group.Key.GroupSequence) || group.Key.GroupName is null)
                {
                <div class="space-y-0.5">
                    @* Scheme groups (no route) render as collapsible headers with their children nested. *@
                    @foreach (var item in group.Where(m => m.Route is null))
                    {
                        var schemeCode = item.PageName;
                        var expanded = _expanded.Contains(schemeCode) || group.Any(c => c.Route == _activeRoute);
                        <div @key="@item.PageName">
                            <button type="button" @onclick="() => Toggle(schemeCode)" title="@(Collapsed ? item.PageName : null)"
                                    class="@NavLinkClass() w-full text-left">
                                @NavIcon(item.Icon)
                                <span class="flex-1 @(Collapsed ? "hidden" : "")">@item.PageName</span>
                                <svg class="@(Collapsed ? "hidden" : "") h-4 w-4 shrink-0 transition-transform duration-200 @(expanded ? "rotate-90" : "")"
                                     viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                                </svg>
                            </button>
                            @if (expanded && !Collapsed)
                            {
                                <div class="ml-6 space-y-0.5 border-l border-gray-200 pl-2 dark:border-gray-700">
                                    @foreach (var child in group.Where(m => m.Route is not null && IsChildOf(group, item, m)))
                                    {
                                        <NavLink @key="child.Route" href="@child.Route" Match="NavLinkMatch.Prefix"
                                                 class="group flex items-center gap-2.5 rounded-lg px-3 py-1.5 text-[13px] font-medium text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
                                                 ActiveClass="!bg-primary-50 !text-primary-700 dark:!bg-primary-900/40 dark:!text-primary-200">
                                            @NavIcon(child.Icon)
                                            <span>@child.PageName</span>
                                        </NavLink>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @* Top-level routed items (Dashboard, Exceptions, …) render as before. *@
                    @foreach (var item in group.Where(m => m.Route is not null && !HasSchemeParent(group, m)))
                    {
                        <NavLink @key="item.Route" href="@item.Route" Match="@(item.Route == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                                 title="@(Collapsed ? item.PageName : null)"
                                 class="@NavLinkClass()"
                                 ActiveClass="!bg-primary-50 !text-primary-700 dark:!bg-primary-900/40 dark:!text-primary-200">
                            @NavIcon(item.Icon)
                            <span class="@(Collapsed ? "hidden" : "")">@item.PageName</span>
                        </NavLink>
                    }
                </div>
                }
            </div>
        }
    </nav>

    <div class="border-t border-gray-200 p-3 dark:border-gray-800">
        <div class="flex items-center gap-3 rounded-lg px-2 py-1.5 @(Collapsed ? "justify-center" : "")">
            <AvatarInitials Name="@_fullName" Size="sm" />
            <div class="min-w-0 flex-1 leading-tight @(Collapsed ? "hidden" : "")">
                <p class="truncate text-sm font-medium text-gray-900 dark:text-white">@_fullName</p>
                <p class="truncate text-[11px] text-gray-400">@_roleLabel</p>
            </div>
        </div>
    </div>
</aside>

@code {
    [Parameter] public bool Collapsed { get; set; }
    private IReadOnlyList<MenuItem> _menu = [];
    private string _fullName = "";
    private string _roleLabel = "";
    private string? _activeRoute;
    private HashSet<string> _expanded = new();
    private HashSet<string> _collapsedGroups = new();

    private static string GroupKey(string? groupName, int groupSequence) => $"{groupSequence}:{groupName}";
    private bool IsGroupExpanded(string? groupName, int groupSequence) => !_collapsedGroups.Contains(GroupKey(groupName, groupSequence));

    private void ToggleGroup(string groupKey)
    {
        if (!_collapsedGroups.Add(groupKey)) _collapsedGroups.Remove(groupKey);
    }

    private void Toggle(string schemeName)
    {
        if (!_expanded.Remove(schemeName)) _expanded.Add(schemeName);
    }

    /// <summary>True when the child belongs to the scheme header (same group, not the header itself).</summary>
    private static bool IsChildOf(IEnumerable<MenuItem> group, MenuItem header, MenuItem child) =>
        child.Route is not null && !ReferenceEquals(child, header);

    /// <summary>True when the item's parent is a scheme header (routed scheme children are rendered nested).</summary>
    private bool HasSchemeParent(IGrouping<object, MenuItem> group, MenuItem item) =>
        group.Any(m => m.Route is null && !ReferenceEquals(m, item));

    private string NavLinkClass() => "group flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white" + (Collapsed ? " justify-center" : "");

    private RenderFragment NavIcon(string? icon) => icon switch
    {
        "dashboard" => @<GridIcon Class="h-5 w-5 shrink-0" />,
        "atm" => @<RocketIcon Class="h-5 w-5 shrink-0" />,
        "pos" => @<TableRowIcon Class="h-5 w-5 shrink-0" />,
        "bulk" => @<ChartIcon Class="h-5 w-5 shrink-0" />,
        "analysis" => @<ChartIcon Class="h-5 w-5 shrink-0" />,
        "alert" => @<ExclamationTriangleIcon Class="h-5 w-5 shrink-0" />,
        "import" => @<FileImportIcon Class="h-5 w-5 shrink-0" />,
        "list" => @<ListIcon Class="h-5 w-5 shrink-0" />,
        "users" => @<UsersIcon Class="h-5 w-5 shrink-0" />,
        "roles" => @<LockIcon Class="h-5 w-5 shrink-0" />,
        _ => @<FolderIcon Class="h-5 w-5 shrink-0" />
    };

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var idClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!Guid.TryParse(idClaim, out var userId)) return;

        _menu = await Permissions.GetMenuAsync(userId);
        _activeRoute = Nav.Uri;
        Nav.LocationChanged += (_, e) => { _activeRoute = e.Location; InvokeAsync(StateHasChanged); };

        await using var db = await DbFactory.CreateDbContextAsync();
        var info = await db.Users
            .Where(u => u.Id == userId)
            .Select(u => new { u.FullName, Roles = u.UserAppAccesses.Where(a => a.IsActive).Select(a => a.AppAccess.AccessName).ToList() })
            .FirstOrDefaultAsync();
        _fullName = info?.FullName ?? state.User.Identity?.Name ?? "";
        _roleLabel = info?.Roles.Count > 0 ? string.Join(", ", info.Roles) : "No role";
    }
}
