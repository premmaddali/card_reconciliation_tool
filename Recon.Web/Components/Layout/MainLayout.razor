@inherits LayoutComponentBase
@inject IJSRuntime Js

<div class="flex h-screen overflow-hidden bg-gray-50 dark:bg-gray-950">
    <SideNav Collapsed="@_sideNavCollapsed" />

    <div class="flex flex-1 flex-col overflow-hidden">
        <header class="flex h-16 shrink-0 items-center justify-between border-b border-gray-200 bg-white px-6 dark:border-gray-800 dark:bg-gray-900">
            <div class="flex items-center gap-3">
                <button type="button" title="Toggle navigation" @onclick="ToggleSideNav"
                        class="rounded-lg p-2 text-gray-400 transition-colors hover:bg-gray-100 hover:text-gray-600 dark:hover:bg-gray-800 dark:hover:text-gray-300">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
                </button>
                <span class="text-sm text-gray-400 dark:text-gray-500">Reconciliation Platform</span>
            </div>
            <div class="flex items-center gap-1.5">
                <button type="button" title="Toggle dark mode"
                        class="rounded-lg p-2 text-gray-400 transition-colors hover:bg-gray-100 hover:text-gray-600 dark:hover:bg-gray-800 dark:hover:text-gray-300"
                        @onclick="ToggleTheme">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M21.75 12.001a9.72 9.72 0 0 1-9.75 9.75 9.72 9.72 0 0 1-8.4-4.851 9.68 9.68 0 0 0 4.65 1.18 9.72 9.72 0 0 0 9.75-9.75 9.68 9.68 0 0 0-1.18-4.65 9.72 9.72 0 0 1 4.93 8.32Z" />
                    </svg>
                </button>
                <form method="post" action="/auth/logout" title="Sign out">
                    <AntiforgeryToken />
                    <button type="submit" class="rounded-lg p-2 text-gray-400 transition-colors hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-900/30 dark:hover:text-red-300">
                        <ArrowRightToBracketIcon Class="h-5 w-5" />
                    </button>
                </form>
                <div class="mx-2 h-6 w-px bg-gray-200 dark:bg-gray-700"></div>
                <AuthorizeView>
                    <Authorized>
                        <div class="flex items-center gap-2.5">
                            <AvatarInitials Name="@(context.User.Identity?.Name ?? "?")" Size="sm" />
                            <span class="text-sm font-medium text-gray-700 dark:text-gray-200">@context.User.Identity?.Name</span>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>
        </header>

        <main class="flex-1 overflow-y-auto">
            <div class="mx-auto max-w-screen-2xl p-6">
                @Body
            </div>
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet class="hidden fixed bottom-0 left-0 right-0 z-50 bg-yellow-100 p-4 text-sm text-yellow-900 shadow-lg">
    An unhandled error has occurred.
    <a href="." class="font-semibold underline">Reload</a>
    <span class="cursor-pointer float-right" onclick="this.parentElement.classList.add('hidden')">🗙</span>
</div>

@code {
    private bool _sideNavCollapsed;
    private async Task ToggleTheme() => await Js.InvokeVoidAsync("appTheme.toggle");
    private void ToggleSideNav() => _sideNavCollapsed = !_sideNavCollapsed;
}
